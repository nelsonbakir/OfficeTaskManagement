@using Microsoft.AspNetCore.Identity
@using OfficeTaskManagement.Models
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskFlow</title>
    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom Landing Page CSS -->
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <!-- Theme Manager -->
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
</head>
<body class="landing-body">
    <!-- Floating Navbar -->
    <nav class="navbar navbar-expand-lg landing-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand" href="#hero">
                <i class="fas fa-tasks text-primary"></i> TaskFlow
            </a>
            <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#landingNavbarNav" aria-controls="landingNavbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <i class="fas fa-bars"></i>
            </button>
            <div class="collapse navbar-collapse" id="landingNavbarNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="#features">Features</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#tech-stack">Tech Stack</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#sandbox">Interactive Demo</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#faqs">FAQs</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <!-- Theme Toggle Button -->
                    <button class="btn btn-landing-outline theme-toggle-btn py-2 px-3" type="button" title="Toggle theme">
                        <i class="fas fa-moon"></i>
                    </button>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <span class="text-secondary d-none d-xl-inline me-1">Hello, @(User.Identity?.Name?.Split('@')[0] ?? "User")!</span>
                        <a class="btn btn-landing-primary" asp-area="" asp-controller="Analytics" asp-action="Index">
                            <i class="fas fa-chart-line me-1"></i> Dashboard
                        </a>
                        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                            <button type="submit" class="btn btn-landing-outline py-2">
                                <i class="fas fa-sign-out-alt"></i>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="btn-landing-outline" asp-area="Identity" asp-page="/Account/Login">
                            <i class="fas fa-sign-in-alt me-1"></i> Login
                        </a>
                        <a class="btn btn-landing-primary" asp-area="Identity" asp-page="/Account/Register">
                            Get Started <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="landing-footer">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4">
                    <h5 class="fw-bold mb-3"><i class="fas fa-tasks text-primary me-2"></i>TaskFlow</h5>
                    <p class="text-muted pe-lg-4">An advanced project management app featuring automatic stage-gate validation, RACI task assignments, visual capacity plans, and AI-driven status insights.</p>
                    <div class="footer-social-icons">
                        <a href="#"><i class="fab fa-github"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                        <a href="#"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <h5>Platform</h5>
                    <ul class="landing-footer-links">
                        <li><a href="#features">Features</a></li>
                        <li><a href="#sandbox">Live Sandbox</a></li>
                        <li><a href="#tech-stack">Tech Stack</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <h5>Governance</h5>
                    <ul class="landing-footer-links">
                        <li><a href="#features">RACI Matrix</a></li>
                        <li><a href="#features">Stage-Gates</a></li>
                        <li><a href="#features">Lag Scheduling</a></li>
                    </ul>
                </div>
                <div class="col-md-6 col-lg-4">
                    <h5>AI Ecosystem</h5>
                    <ul class="landing-footer-links">
                        <li><span class="text-secondary"><i class="fas fa-robot me-1 text-primary"></i> Gemini PM Knowledge RAG</span></li>
                        <li><span class="text-secondary"><i class="fas fa-bolt me-1 text-primary"></i> Nightly Model Calibration</span></li>
                        <li><span class="text-secondary"><i class="fas fa-shield-alt me-1 text-primary"></i> Proactive Risk Radar Scanner</span></li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary opacity-10">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center pt-2">
                <p class="mb-0 text-muted">&copy; 2026 TaskFlow. Built for high-performance delivery. All rights reserved.</p>
                <div class="d-flex gap-3 mt-2 mt-md-0">
                    <a href="#" class="text-muted text-decoration-none">Privacy Policy</a>
                    <span class="text-muted">|</span>
                    <a href="#" class="text-muted text-decoration-none">Terms of Service</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
