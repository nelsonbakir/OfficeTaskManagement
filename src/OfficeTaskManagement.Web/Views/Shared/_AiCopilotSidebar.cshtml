@* AI Copilot Sidebar — Phase 4 Multi-turn Copilot
   Spec: ai-agent-plan/07_FRONTEND_UX.md → FLOW 7
   Always injected via _Layout.cshtml; hidden by default.
   JS: wwwroot/js/copilot-sidebar.js *@

<div id="ai-copilot-sidebar" class="copilot-sidebar" role="complementary" aria-label="AI Copilot" aria-hidden="true">

    <!-- Sidebar Header -->
    <div class="copilot-sidebar__header">
        <span class="copilot-sidebar__icon" aria-hidden="true">🤖</span>
        <span class="copilot-sidebar__title">AI Copilot</span>
        <select id="copilot-project-selector" class="copilot-sidebar__project-select" aria-label="Select Project Context">
            <option value="">-- Project Context --</option>
        </select>
        <div class="copilot-sidebar__header-actions">
            <button type="button" id="copilot-clear-btn"
                    class="copilot-sidebar__clear-btn"
                    aria-label="Clear conversation history"
                    title="Clear conversation">
                🗑
            </button>
            <button type="button" id="copilot-close-btn"
                    class="copilot-sidebar__close-btn"
                    aria-label="Close AI Copilot sidebar">
                ✕
            </button>
        </div>
    </div>

    <!-- Session Management Bar -->
    <div id="copilot-session-bar" class="copilot-sidebar__session-bar" style="display: none; align-items: center; gap: 0.5rem; padding: 0.5rem 0.75rem; background: rgba(255,255,255,0.02); border-bottom: 1px solid rgba(255,255,255,0.08);">
        <select id="copilot-session-selector" class="copilot-sidebar__session-select" aria-label="Select Chat Session" style="flex: 1; font-size: 0.75rem; padding: 0.25rem 0.5rem; border-radius: 4px; border: 1px solid rgba(255,255,255,0.15); background: transparent; color: #94a3b8; outline: none; cursor: pointer;">
            <option value="">-- Select Chat Session --</option>
        </select>
        <button type="button" id="copilot-new-session-btn" class="copilot-sidebar__new-session-btn" title="Start New Session" style="font-size: 0.72rem; padding: 0.25rem 0.6rem; border-radius: 4px; border: 1px solid rgba(99,102,241,0.3); background: rgba(99,102,241,0.1); color: #818cf8; cursor: pointer; transition: all 0.15s ease; white-space: nowrap; font-weight: 500;">
            ➕ New
        </button>
    </div>

    <!-- WBS Resume Draft Banner -->
    <div id="copilot-wbs-resume-bar" style="display: none; align-items: center; justify-content: space-between; padding: 0.5rem 0.75rem; background: rgba(99,102,241,0.08); border-bottom: 1px solid rgba(99,102,241,0.2); gap: 0.5rem;">
        <span style="font-size: 0.75rem; color: #a5b4fc; font-weight: 500; display: flex; align-items: center; gap: 0.35rem;">
            🗺 Unsaved WBS Draft
        </span>
        <button type="button" onclick="resumeWbsWizard()" style="font-size: 0.7rem; padding: 0.25rem 0.6rem; border-radius: 4px; border: 1px solid rgba(99,102,241,0.4); background: #6366f1; color: #fff; cursor: pointer; font-weight: 600; text-transform: uppercase; letter-spacing: 0.3px;">
            Resume Wizard
        </button>
    </div>

    <!-- Failed Jobs Alert Panel -->
    <div id="copilot-failed-jobs-panel" class="copilot-sidebar__failed-jobs-panel" style="display: none; background: rgba(239, 68, 68, 0.05); border-bottom: 1px solid rgba(239, 68, 68, 0.15); padding: 0.5rem 0.75rem;">
        <div style="display: flex; align-items: center; justify-content: space-between;">
            <span style="font-size: 0.75rem; font-weight: 600; color: #f87171; display: flex; align-items: center; gap: 0.3rem;">
                ⚠️ Failed Cloud Jobs (<span id="failed-jobs-count">0</span>)
            </span>
            <button type="button" id="failed-jobs-toggle" style="background: transparent; border: none; color: #f87171; font-size: 0.7rem; cursor: pointer; text-decoration: underline; padding: 0; outline: none;">
                Show
            </button>
        </div>
        <div id="failed-jobs-list" style="display: none; margin-top: 0.5rem; max-height: 120px; overflow-y: auto; gap: 0.4rem; flex-direction: column;">
            <!-- Populated by JS -->
        </div>
    </div>

    <!-- Conversation display -->
    <div id="copilot-messages" class="copilot-sidebar__messages" role="log" aria-live="polite" aria-label="Conversation">
        <!-- Welcome message -->
        <div class="copilot-msg copilot-msg--ai">
            <span class="copilot-msg__avatar" aria-hidden="true">🤖</span>
            <div class="copilot-msg__bubble">
                <p>Hello! I'm your AI PM Copilot. I can help you:</p>
                <ul>
                    <li>Create full project plans from meeting notes (<strong>/plan</strong>)</li>
                    <li>Generate PM status reports and risk analyses</li>
                    <li>Smart sprint planning based on team capacity</li>
                    <li>Analyze resource availability and PERT estimates</li>
                    <li>Type <strong>/help</strong> for all commands or <strong>@@</strong> to mention any entity</li>
                </ul>
                <p>What would you like to do?</p>
            </div>
        </div>
    </div>

    <!-- Action buttons (populated by JS from AgentAction[] responses) -->
    <div id="copilot-actions" class="copilot-sidebar__actions" style="display:none" aria-label="Suggested actions">
        <!-- Populated by copilot-sidebar.js -->
    </div>

    <!-- Quick Actions -->
    <div class="copilot-sidebar__quick-actions" aria-label="Quick actions">
        <button type="button" class="copilot-quick-btn" data-command="/plan" title="Turn meeting notes into a project plan">
            <span aria-hidden="true">🗺</span> Plan
        </button>
        <button type="button" class="copilot-quick-btn" data-command="/report" title="Generate PM Status Report">
            <span aria-hidden="true">📋</span> Report
        </button>
        <button type="button" class="copilot-quick-btn" data-command="/risk" title="Analyze project risks">
            <span aria-hidden="true">⚠</span> Risk
        </button>
        <button type="button" class="copilot-quick-btn" data-command="/sprint" title="AI Sprint Planning">
            <span aria-hidden="true">🚀</span> Sprint
        </button>
        <button type="button" class="copilot-quick-btn" data-command="/standup" title="Generate standup digest">
            <span aria-hidden="true">🌅</span> Standup
        </button>
    </div>

    <!-- Input area -->
    <div class="copilot-sidebar__input-area">
        <div class="copilot-sidebar__input-wrapper">
            <div class="copilot-sidebar__textarea-container">
                <textarea id="copilot-input"
                          class="copilot-sidebar__input"
                          placeholder="Ask me anything about this project..."
                          rows="2"
                          aria-label="Message to AI Copilot"
                          maxlength="2000"></textarea>
            </div>
            <button type="button" id="copilot-send-btn"
                    class="copilot-sidebar__send-btn"
                    aria-label="Send message"
                    disabled>
                <span aria-hidden="true">↑</span>
            </button>
        </div>
        <div class="copilot-sidebar__input-footer">
            <span class="copilot-sidebar__hint">Enter to send · Shift+Enter for new line</span>
            <span id="copilot-char-count" class="copilot-sidebar__char-count">0/2000</span>
        </div>
    </div>
</div>

<!-- Floating toggle button (always visible when sidebar is closed) -->
<button type="button" id="copilot-toggle-btn"
        class="copilot-toggle-btn"
        aria-label="Open AI Copilot"
        aria-expanded="false"
        aria-controls="ai-copilot-sidebar">
    <span class="copilot-toggle-btn__icon" aria-hidden="true">🤖</span>
    <span class="copilot-toggle-btn__label">AI Copilot</span>
</button>

<!-- WBS Planning Wizard Modal -->
<div class="modal fade animate-fade-in" id="wbsWizardModal" tabindex="-1" aria-labelledby="wbsWizardModalLabel" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden; background: #fff;">
            <div class="modal-header border-bottom px-4 py-3" style="background: #f8fafc;">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center" id="wbsWizardModalLabel" style="font-size: 1.15rem;">
                    <span style="font-size: 1.4rem; margin-right: 0.6rem;">🗺</span>
                    WBS Planning Wizard
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" style="background: #f1f5f9; min-height: 350px;">
                <div class="alert alert-info border-0 shadow-sm d-flex align-items-start mb-4" style="border-radius: 8px; background-color: #e0f2fe; color: #0369a1;">
                    <span style="font-size: 1.25rem; margin-right: 0.5rem; margin-top: -1px;">ℹ</span>
                    <div>
                        <strong style="font-weight: 600;">Plan Customization Flow:</strong> Review the AI-generated work package hierarchy below. You can modify names, descriptions, and estimates directly. Task estimations automatically calculate PERT values. Click <strong>Apply & Create Plan</strong> when ready.
                    </div>
                </div>
                <div id="wbs-wizard-editor-root" class="wbs-wizard-root">
                    <!-- Dynamic hierarchical inputs loaded here -->
                </div>
            </div>
            <div class="modal-footer border-top px-4 py-3 d-flex justify-content-between" style="background: #f8fafc;">
                <div>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="wbs-wizard-add-epic-btn" style="border-radius: 6px; font-weight: 500; font-size: 0.85rem; padding: 0.4rem 0.8rem;">
                        ➕ Add Epic
                    </button>
                </div>
                <div class="d-flex align-items-center">
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal" style="border-radius: 6px; font-size: 0.85rem; padding: 0.4rem 1rem;">Cancel</button>
                    <button type="button" class="btn btn-primary" id="wbs-wizard-apply-btn" style="border-radius: 6px; font-size: 0.85rem; padding: 0.4rem 1.2rem; font-weight: 500; background-color: #6366f1; border-color: #6366f1; box-shadow: 0 2px 6px rgba(99, 102, 241, 0.2);">
                        Apply & Create Plan
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
