@model OfficeTaskManagement.ViewModels.RoleManagement.EditRoleViewModel
@{
    ViewData["Title"] = $"Edit Role — {Model.Name}";
    var colorOptions = new[] {
        ("#dc3545","Red","fas fa-crown"),("#6610f2","Purple","fas fa-shield-alt"),
        ("#0d6efd","Blue","fas fa-user-tie"),("#0dcaf0","Cyan","fas fa-user-astronaut"),
        ("#20c997","Teal","fas fa-people-arrows"),("#198754","Green","fas fa-code"),
        ("#fd7e14","Orange","fas fa-vial"),("#6c757d","Grey","fas fa-user"),
        ("#ffc107","Yellow","fas fa-star"),("#6f42c1","Indigo","fas fa-sitemap")
    };
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div>
        <h1 class="h3 fw-bold mb-0">
            <i class="fas fa-edit me-2 text-primary"></i>Edit Role
            <span class="badge rounded-pill ms-2" style="background-color:@Model.Color; font-size:0.7rem;">
                <i class="@Model.Icon me-1"></i>@Model.Name
            </span>
        </h1>
        <p class="text-muted mb-0 small">Modify role details, visual branding, and permission group assignments.</p>
    </div>
</div>

@if (Model.IsSystemRole)
{
    <div class="alert alert-info border-0 mb-4">
        <i class="fas fa-info-circle me-2"></i>
        This is a <strong>system role</strong>. Its name cannot be changed, but you can edit its description, colour, icon, and permission groups.
    </div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <form asp-action="EditRole" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="IsSystemRole" />

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-info-circle me-2 text-primary"></i>Role Details</h6>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Role Name <span class="text-danger">*</span></label>
                        @if (Model.IsSystemRole)
                        {
                            <input asp-for="Name" class="form-control" id="roleName" readonly />
                        }
                        else
                        {
                            <input asp-for="Name" class="form-control" id="roleName" />
                        }
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="HierarchyLevel" class="form-label fw-semibold">
                            Hierarchy Level
                            <span class="text-muted small fw-normal">(0 = Super Admin only)</span>
                        </label>
                        @if (Model.HierarchyLevel == 0)
                        {
                            <input asp-for="HierarchyLevel" type="number" class="form-control" min="0" max="99" readonly />
                        }
                        else
                        {
                            <input asp-for="HierarchyLevel" type="number" class="form-control" min="1" max="99" />
                        }
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-palette me-2 text-primary"></i>Visual Identity</h6>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Colour</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var (hex, name, icon) in colorOptions)
                                {
                                    <label class="color-option" title="@name">
                                        <input type="radio" name="Color" value="@hex" @(hex == Model.Color ? "checked" : "") hidden />
                                        <span class="d-flex align-items-center justify-content-center rounded-circle color-swatch"
                                              style="width:32px;height:32px;background:@hex;cursor:pointer;border:2px solid transparent;transition:all 0.15s;">
                                        </span>
                                    </label>
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Icon</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var (hex, name, icon) in colorOptions)
                                {
                                    <label class="icon-option" title="@icon">
                                        <input type="radio" name="Icon" value="@icon" @(icon == Model.Icon ? "checked" : "") hidden />
                                        <span class="d-flex align-items-center justify-content-center rounded icon-swatch"
                                              style="width:36px;height:36px;background:#f8f9fa;cursor:pointer;border:2px solid transparent;transition:all 0.15s;">
                                            <i class="@icon text-secondary"></i>
                                        </span>
                                    </label>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="mt-3 p-3 rounded" style="background:#f8f9fa;">
                        <small class="text-muted d-block mb-2">Preview:</small>
                        <span id="rolePreviewBadge" class="badge rounded-pill fs-6 px-3 py-2" style="background-color:@Model.Color;">
                            <i id="rolePreviewIcon" class="@Model.Icon me-2"></i>
                            <span id="rolePreviewName">@Model.Name</span>
                        </span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="fas fa-save me-2"></i>Save Changes
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>

    <!-- Permission Groups -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm" style="position:sticky;top:80px;">
            <div class="card-header bg-transparent border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="fas fa-key me-2 text-primary"></i>Permission Groups</h6>
                <small class="text-muted">Changes take effect on the user's next login</small>
            </div>
            <div class="card-body p-0" style="max-height:520px;overflow-y:auto;">
                @for (int i = 0; i < Model.AvailableGroups.Count; i++)
                {
                    var grp = Model.AvailableGroups[i];
                    var isChecked = Model.SelectedGroupIds.Contains(grp.Id);
                    <div class="permission-group-item p-3 border-bottom @(isChecked ? "bg-selected" : "")"
                         style="cursor:pointer;" onclick="toggleGroupCard(this)">
                        <div class="d-flex align-items-start gap-3">
                            <input type="checkbox" name="SelectedGroupIds" value="@grp.Id"
                                   class="form-check-input mt-1" @(isChecked ? "checked" : "")
                                   onclick="event.stopPropagation()" form="editForm" />
                            <div class="flex-grow-1">
                                <div class="fw-semibold small">@grp.Name</div>
                                @if (!string.IsNullOrEmpty(grp.Description))
                                {
                                    <div class="text-muted" style="font-size:0.75rem;">@grp.Description</div>
                                }
                                <div class="d-flex flex-wrap gap-1 mt-2">
                                    @foreach (var key in grp.Keys.Take(6))
                                    {
                                        <span class="badge bg-light text-secondary border" style="font-size:0.6rem;">@key</span>
                                    }
                                    @if (grp.Keys.Count > 6)
                                    {
                                        <span class="badge bg-light text-secondary border" style="font-size:0.6rem;">+@(grp.Keys.Count-6) more</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <!-- The checkboxes for groups must be inside the main form -->
            <div class="card-footer bg-transparent border-top p-3">
                <small class="text-muted"><i class="fas fa-info-circle me-1"></i>Group selections are saved with the main form.</small>
            </div>
        </div>
    </div>
</div>

<style>
    .color-swatch.active, .color-option input:checked + .color-swatch { border-color: #000 !important; transform:scale(1.2); }
    .icon-swatch.active, .icon-option input:checked + .icon-swatch { border-color:#0d6efd!important;background:#e8f0fe!important; }
    .permission-group-item:hover { background:#f8f9fa; }
    .permission-group-item:has(input:checked) { background:#e8f0fe; }
</style>

@section Scripts {
<script>
    function toggleGroupCard(el) {
        const cb = el.querySelector('input[type=checkbox]');
        cb.checked = !cb.checked;
        el.style.background = cb.checked ? '#e8f0fe' : '';
    }
    const nameInput = document.getElementById('roleName');
    const previewBadge = document.getElementById('rolePreviewBadge');
    const previewIcon = document.getElementById('rolePreviewIcon');
    const previewName = document.getElementById('rolePreviewName');
    nameInput?.addEventListener('input', () => previewName.textContent = nameInput.value || 'Role Name');
    document.querySelectorAll('input[name="Color"]').forEach(r => r.addEventListener('change', () => previewBadge.style.backgroundColor = r.value));
    document.querySelectorAll('input[name="Icon"]').forEach(r => r.addEventListener('change', () => previewIcon.className = r.value + ' me-2'));
</script>
}
