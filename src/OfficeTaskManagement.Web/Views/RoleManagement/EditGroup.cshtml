@model OfficeTaskManagement.ViewModels.RoleManagement.EditPermissionGroupViewModel
@{
    ViewData["Title"] = $"Edit Group — {Model.Name}";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="PermissionGroups" class="btn btn-sm btn-outline-secondary"><i class="fas fa-arrow-left"></i></a>
    <div>
        <h1 class="h3 fw-bold mb-0"><i class="fas fa-edit me-2 text-primary"></i>Edit Permission Group — @Model.Name</h1>
        <p class="text-muted mb-0 small">Update keys and description. Changes apply on users' next login.</p>
    </div>
</div>

@if (Model.IsSystemGroup)
{
    <div class="alert alert-info border-0 mb-4">
        <i class="fas fa-info-circle me-2"></i>
        This is a <strong>system group</strong>. You can edit its keys and description, but it cannot be deleted.
    </div>
}

<form asp-action="EditGroup" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="IsSystemGroup" />
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm" style="background: var(--bg-surface); border: 1px solid var(--border-color);">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-info-circle me-2 text-primary"></i>Group Details</h6>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Group Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-2"></i>Save Changes</button>
                <a asp-action="PermissionGroups" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm" style="background: var(--bg-surface); border: 1px solid var(--border-color);">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-key me-2 text-primary"></i>Permission Keys</h6>
                    <div class="d-flex gap-2 mt-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAll(true)">Select All</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAll(false)">Clear All</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        @foreach (var key in Model.AllKnownKeys)
                        {
                            <div class="col-md-6">
                                <label class="perm-key-item d-flex align-items-center gap-2 p-2 rounded border"
                                style="cursor:pointer; transition:background 0.15s; @(Model.SelectedKeys.Contains(key) ? "background:rgba(0,120,212,0.08);border-color:var(--primary-color);" : "")">
                                    <input type="checkbox" name="SelectedKeys" value="@key"
                                           class="form-check-input m-0" @(Model.SelectedKeys.Contains(key) ? "checked" : "") />
                                    <span class="font-monospace small">@key</span>
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<style>
    .perm-key-item:hover { background:var(--light-bg); border-color:var(--primary-color)!important; }
    .perm-key-item:has(input:checked) { background:rgba(0, 120, 212, 0.08); border-color:var(--primary-color)!important; }
</style>
@section Scripts {
<script>
function selectAll(checked) {
    document.querySelectorAll('input[name="SelectedKeys"]').forEach(cb => {
        cb.checked = checked;
        cb.closest('.perm-key-item').style.background = checked ? 'rgba(0, 120, 212, 0.08)' : '';
    });
}
</script>
}
