@model OfficeTaskManagement.Models.Sprint
@{ ViewData["Title"] = Model.Name; }

<style>
    .sprint-detail-header {
        background: var(--bg-surface);
        border-bottom: 1px solid var(--border-color);
        padding: 2rem;
        margin: -2rem -2rem 2rem -2rem;
        border-radius: 6px 6px 0 0;
    }

    .sprint-detail-title {
        font-size: 2rem;
        font-weight: 600;
        margin: 0 0 1.5rem 0;
        color: var(--text-primary);
    }

    .detail-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
        margin-bottom: 1rem;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
    }

    .detail-label {
        color: var(--text-secondary);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
    }

    .detail-value {
        color: var(--text-primary);
        font-weight: 500;
        font-size: 1.1rem;
    }

    .status-badge {
        display: inline-block;
        padding: 0.5rem 1rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.85rem;
        width: fit-content;
    }

    .status-badge.active {
        background: #D4EDDA;
        color: #155724;
    }

    .status-badge.inactive {
        background: var(--light-bg);
        color: var(--text-secondary);
    }

    .back-button {
        margin-top: 1rem;
    }

    .tasks-section {
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 2rem;
        margin-top: 2rem;
    }

    .tasks-section h2 {
        font-size: 1.3rem;
        font-weight: 600;
        margin: 0 0 1.5rem 0;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
    }

    .task-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .task-row {
        background: var(--light-bg);
        padding: 1rem;
        border-radius: 4px;
        border-left: 3px solid var(--primary-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: all 0.2s ease;
    }

    .task-row:hover {
        background: var(--border-color);
        transform: translateX(4px);
    }

    .task-content {
        flex: 1;
    }

    .task-title {
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 0.25rem;
    }

    .task-meta {
        font-size: 0.85rem;
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .task-meta i {
        color: var(--primary-color);
    }

    .task-status {
        padding: 0.25rem 0.75rem;
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        border-radius: 3px;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .task-actions {
        display: flex;
        gap: 0.5rem;
    }

    .task-action-btn {
        padding: 0.5rem 0.75rem;
        border-radius: 4px;
        border: 1px solid var(--border-color);
        background: var(--bg-surface);
        color: var(--primary-color);
        text-decoration: none;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .task-action-btn:hover {
        background: var(--light-bg);
        color: var(--primary-dark);
        border-color: var(--primary-color);
    }

    .empty-tasks {
        text-align: center;
        padding: 2rem;
        color: var(--text-secondary);
    }

    .empty-tasks i {
        font-size: 2rem;
        color: var(--border-color);
        display: block;
        margin-bottom: 0.5rem;
    }

    .action-buttons {
        display: flex;
        gap: 0.75rem;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border-color);
    }

    .action-buttons a, .action-buttons button {
        padding: 0.625rem 1.25rem;
        border-radius: 4px;
        border: none;
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .action-buttons .btn-primary {
        background: var(--primary-color);
        color: white;
    }

    .action-buttons .btn-primary:hover {
        background: var(--primary-dark);
    }

    .action-buttons .btn-secondary {
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        color: var(--text-primary);
    }

    .action-buttons .btn-secondary:hover {
        background: var(--light-bg);
    }

    .action-buttons .btn-danger {
        background: var(--bg-surface);
        border: 1px solid #E81123;
        color: #E81123;
    }

    .action-buttons .btn-danger:hover {
        background: rgba(232, 17, 35, 0.05);
    }
</style>

<div class="sprint-detail-header">
    <h1 class="sprint-detail-title">
        <i class="fas fa-rocket"></i> @Model.Name
    </h1>

    <div class="detail-grid">
        <div class="detail-item">
            <span class="detail-label">Project</span>
            <span class="detail-value">@Model.Project?.Name</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Start Date</span>
            <span class="detail-value">@Model.StartDate.ToString("MMM dd, yyyy")</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">End Date</span>
            <span class="detail-value">@Model.EndDate.ToString("MMM dd, yyyy")</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Status</span>
            <div class="status-badge @(Model.IsActive ? "active" : "inactive")">
                @(Model.IsActive ? "Active" : "Completed")
            </div>
        </div>
    </div>

    <div class="action-buttons">
        @if(await PermSvc.HasPermissionAsync(User, Permissions.SprintsManage)) {
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn-primary">
                <i class="fas fa-edit"></i> Edit Sprint
            </a>
            <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn-danger" onclick="return confirm('Are you sure?')">
                <i class="fas fa-trash"></i> Delete
            </a>
        }
        <button type="button" id="sprint-ai-assist-btn"
                class="btn-secondary"
                style="background:linear-gradient(90deg,#6c47ff,#a855f7);color:white;border:none;cursor:pointer;"
                aria-label="Open AI Sprint Planning Assistant"
                title="AI analyzes capacity vs backlog demand and suggests tasks to pull in">
            <span aria-hidden="true">✨</span> AI Sprint Assist
        </button>
        <a asp-action="Index" class="btn-secondary">
            <i class="fas fa-arrow-left"></i> Back
        </a>
    </div>
</div>

@* T56: Sprint AI Assist — primes the copilot with sprint context *@
<meta name="ai-entity-type" content="Sprint" />
<meta name="ai-entity-id"   content="@Model.Id" />
@section Scripts {
    <script>
    (function() {
        var btn = document.getElementById('sprint-ai-assist-btn');
        if (!btn) return;
        btn.addEventListener('click', function() {
            // Open the copilot sidebar
            var toggleBtn = document.getElementById('copilot-toggle-btn');
            toggleBtn?.click();

            // Give it 300ms to open, then inject context message
            setTimeout(function() {
                var input = document.getElementById('copilot-input');
                var sendBtn = document.getElementById('copilot-send-btn');
                if (!input || !sendBtn) return;

                var sprintName = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Name));
                var taskCount  = @Model.Tasks.Count;
                var startDate  = "@Model.StartDate.ToString("MMM dd")";
                var endDate    = "@Model.EndDate.ToString("MMM dd, yyyy")";

                input.value = `I'm planning sprint "${sprintName}" (${startDate}–${endDate}). It currently has ${taskCount} tasks. Analyze our backlog and resource capacity, then suggest which additional tasks should be pulled into this sprint based on priority, resource availability, and PERT estimates.`;
                input.dispatchEvent(new Event('input'));
                sendBtn.disabled = false;
            }, 350);
        });
    })();
    </script>
}


<div class="tasks-section">
    <h2>
        <i class="fas fa-tasks"></i> Tasks in Sprint (@Model.Tasks.Count)
    </h2>

    @if (Model.Tasks.Any()) {
        <div class="task-list">
            @foreach (var task in Model.Tasks.OrderBy(t => t.Status)) {
                <div class="task-row">
                    <div class="task-content">
                        <div class="task-title">@task.Title</div>
                        <div class="task-meta">
                            @if(task.Assignee != null) {
                                <span>
                                    <i class="fas fa-user-circle"></i> @task.Assignee.FullName
                                </span>
                            }
                            @if(!string.IsNullOrEmpty(task.Description)) {
                                <span style="margin: 0 0.5rem;">•</span>
                                <span title="@task.Description">
                                    <i class="fas fa-align-left"></i> Description
                                </span>
                            }
                        </div>
                    </div>
                    <div class="task-status">@task.Status</div>
                    <div class="task-actions">
                        <a asp-controller="TaskItems" asp-action="Edit" asp-route-id="@task.Id" class="task-action-btn" title="Edit">
                            <i class="fas fa-pen-to-square"></i> Edit
                        </a>
                    </div>
                </div>
            }
        </div>
    } else {
        <div class="empty-tasks">
            <i class="fas fa-inbox"></i>
            <p>No tasks in this sprint yet</p>
        </div>
    }
</div>
