@model OfficeTaskManagement.ViewModels.Organization.OrganizationIndexViewModel
@{
    ViewData["Title"] = "Organization Settings";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="page-header mb-4">
        <div>
            <h1><i class="fas fa-building text-primary me-2"></i> Organization Settings</h1>
            <p class="text-secondary mb-0">Manage your workspace details, members, and global configurations.</p>
        </div>
    </div>

    <!-- Generated Invitation Link Callout (High Visibility Alert) -->
    @if (TempData["CreatedInviteCode"] != null)
    {
        var inviteUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/Identity/Account/Register?inviteCode={TempData["CreatedInviteCode"]}";
        <div class="card border-primary mb-4 shadow-sm" style="border: 1.5px solid var(--primary-color) !important; background-color: #F3F9FD;">
            <div class="card-body py-4">
                <div class="d-flex align-items-start">
                    <div class="bg-primary bg-opacity-10 text-primary rounded p-3 me-3" style="font-size: 1.5rem; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-link"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h5 class="alert-heading text-primary fw-bold mb-1">Invitation Link Generated!</h5>
                        <p class="text-dark mb-3">Copy the secure registration link below to invite <strong>@TempData["CreatedInviteEmail"]</strong> to your organization:</p>
                        
                        <div class="input-group" style="max-width: 650px;">
                            <input type="text" id="generatedLinkInput" class="form-control font-monospace" value="@inviteUrl" readonly style="font-size: 0.9rem;" />
                            <button class="btn btn-primary" type="button" onclick="copyInviteLink()">
                                <i class="fas fa-copy me-1"></i> Copy Link
                            </button>
                        </div>
                        <small class="text-secondary mt-1 d-block" id="copySuccessMsg" style="display: none !important;"><i class="fas fa-check-circle text-success me-1"></i> Link copied to clipboard!</small>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card h-100 border-0 shadow-sm" style="background: var(--bg-surface); border: 1px solid var(--border-color) !important;">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded p-3 me-3" style="font-size: 1.5rem; width: 56px; height: 56px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-users"></i>
                    </div>
                    <div>
                        <h6 class="text-secondary mb-1">Total Members</h6>
                        <h3 class="fw-bold mb-0">@Model.UserCount</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 border-0 shadow-sm" style="background: var(--bg-surface); border: 1px solid var(--border-color) !important;">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 text-success rounded p-3 me-3" style="font-size: 1.5rem; width: 56px; height: 56px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-folder"></i>
                    </div>
                    <div>
                        <h6 class="text-secondary mb-1">Active Projects</h6>
                        <h3 class="fw-bold mb-0">@Model.ProjectCount</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 border-0 shadow-sm" style="background: var(--bg-surface); border: 1px solid var(--border-color) !important;">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-warning bg-opacity-10 text-warning rounded p-3 me-3" style="font-size: 1.5rem; width: 56px; height: 56px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-rocket"></i>
                    </div>
                    <div>
                        <h6 class="text-secondary mb-1">Sprints Executed</h6>
                        <h3 class="fw-bold mb-0">@Model.SprintCount</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Details and Settings Grid -->
    <div class="row g-4">
        <!-- Directory Area (Left Column) -->
        <div class="col-12 col-lg-8 d-flex flex-column gap-4">
            <!-- Members List Card -->
            <div class="card shadow-sm" style="background: var(--bg-surface); border: 1px solid var(--border-color);">
                <div class="card-header bg-transparent py-3">
                    <h5 class="card-title fw-bold mb-0"><i class="fas fa-users-cog text-secondary me-2"></i> Workspace Members Directory</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 40%;">Member</th>
                                    <th style="width: 30%;">Title / Dept</th>
                                    <th style="width: 30%;">Roles</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in Model.Members)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="user-avatar me-3" style="width: 38px; height: 38px; border-radius: 50%; overflow: hidden; background-color: var(--primary-color); display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;">
                                                    @if (!string.IsNullOrEmpty(member.AvatarPath))
                                                    {
                                                        <img src="@member.AvatarPath" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" />
                                                    }
                                                    else
                                                    {
                                                        <span>@member.FullName.Substring(0, Math.Min(member.FullName.Length, 1)).ToUpper()</span>
                                                    }
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark">@member.FullName</div>
                                                    <div class="text-secondary" style="font-size: 0.8rem;">@member.Email</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-medium text-dark" style="font-size: 0.9rem;">@(!string.IsNullOrEmpty(member.JobTitle) ? member.JobTitle : "No Title")</div>
                                            <div class="text-secondary" style="font-size: 0.8rem;">@(!string.IsNullOrEmpty(member.Department) ? member.Department : "No Department")</div>
                                        </td>
                                        <td>
                                            @foreach (var role in member.Roles)
                                            {
                                                <span class="badge bg-light-blue text-primary border" style="font-size: 0.75rem; font-weight: 500; margin-right: 0.25rem; background-color: #E1F0FC; border-color: #C8E1F5 !important;">@role</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Pending Invitations Card -->
            <div class="card shadow-sm" style="background: var(--bg-surface); border: 1px solid var(--border-color);">
                <div class="card-header bg-transparent py-3">
                    <h5 class="card-title fw-bold mb-0"><i class="fas fa-paper-plane text-secondary me-2"></i> Pending Invitation Links</h5>
                </div>
                <div class="card-body p-0">
                    @if (!Model.PendingInvitations.Any())
                    {
                        <div class="text-center py-5 text-secondary">
                            <i class="fas fa-mail-bulk mb-3" style="font-size: 2.5rem; opacity: 0.4;"></i>
                            <p class="mb-0">No pending invitation links. Invite someone using the panel on the right.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 40%;">Invitee Email</th>
                                        <th style="width: 25%;">Target Role</th>
                                        <th style="width: 20%;">Expires At</th>
                                        <th style="width: 15%;" class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var invite in Model.PendingInvitations)
                                    {
                                        var relativeInviteUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/Identity/Account/Register?inviteCode={invite.InviteCode}";
                                        <tr>
                                            <td>
                                                <div class="fw-bold text-dark">@invite.Email</div>
                                                <span class="text-muted font-monospace" style="font-size: 0.75rem; cursor: pointer;" onclick="copyDirectLink('@relativeInviteUrl')" title="Click to copy link">
                                                    <i class="fas fa-link text-primary me-1"></i> Copy invite link
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-light-green text-success border" style="font-size: 0.75rem; font-weight: 500; background-color: #E2F5E2; border-color: #C1ECC1 !important;">@invite.Role</span>
                                            </td>
                                            <td>
                                                <span class="text-secondary" style="font-size: 0.85rem;">@invite.ExpiresAt.ToString("g")</span>
                                            </td>
                                            <td class="text-end">
                                                <form asp-controller="Organization" asp-action="CancelInvite" method="post" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="inviteCode" value="@invite.InviteCode" />
                                                    <button type="submit" class="btn btn-link text-danger p-0 border-0 me-3" style="font-size: 0.9rem;" onclick="return confirm('Are you sure you want to cancel this invitation?')">
                                                        <i class="fas fa-trash-alt me-1"></i> Cancel
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Preferences & Action Panels (Right Column) -->
        <div class="col-12 col-lg-4 d-flex flex-column gap-4">
            <!-- Invite New Member Panel -->
            <div class="card shadow-sm" style="background: var(--bg-surface); border: 1px solid var(--border-color);">
                <div class="card-header bg-transparent py-3">
                    <h5 class="card-title fw-bold mb-0"><i class="fas fa-user-plus text-secondary me-2"></i> Invite Member</h5>
                </div>
                <div class="card-body">
                    <form asp-controller="Organization" asp-action="InviteMember" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label" for="inviteEmailInput">Invitee Email Address</label>
                            <input type="email" name="email" id="inviteEmailInput" class="form-control" placeholder="colleague@company.com" required />
                            <small class="text-muted">A secure invitation link will be generated.</small>
                        </div>

                        <div class="mb-4">
                            <label class="form-label" for="inviteRoleSelect">Workspace Role</label>
                            <select name="role" id="inviteRoleSelect" class="form-select">
                                <option value="Developer">Developer</option>
                                <option value="QA Engineer">QA Engineer</option>
                                <option value="Project Lead">Project Lead</option>
                                <option value="Super Admin">Super Admin</option>
                            </select>
                            <small class="text-muted">Sets default permission access on registry.</small>
                        </div>

                        <button type="submit" class="btn btn-success w-100" style="background-color: var(--secondary-color); border-color: var(--secondary-color);">
                            <i class="fas fa-paper-plane me-2"></i> Generate Invite Link
                        </button>
                    </form>
                </div>
            </div>

            <!-- Workspace Preferences Card -->
            <div class="card shadow-sm" style="background: var(--bg-surface); border: 1px solid var(--border-color);">
                <div class="card-header bg-transparent py-3">
                    <h5 class="card-title fw-bold mb-0"><i class="fas fa-sliders-h text-secondary me-2"></i> Workspace Preferences</h5>
                </div>
                <div class="card-body">
                    <form asp-controller="Organization" asp-action="UpdateName" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label" for="orgNameInput">Organization Name</label>
                            <input type="text" name="name" id="orgNameInput" class="form-control" value="@Model.Name" required />
                            <small class="text-muted">Display name for your team workspace.</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Organization Identifier (Slug)</label>
                            <input type="text" class="form-control bg-light" value="@Model.Identifier" readonly disabled />
                            <small class="text-muted">Used for workspace URL registration and logins (Read-only).</small>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Workspace Created At</label>
                            <div class="form-control bg-light text-secondary">
                                <i class="fas fa-calendar-alt me-2"></i> @Model.CreatedAt.ToString("MMMM dd, yyyy")
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-save me-2"></i> Save Changes
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyInviteLink() {
            var copyText = document.getElementById("generatedLinkInput");
            copyText.select();
            copyText.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(copyText.value);
            
            var msg = document.getElementById("copySuccessMsg");
            msg.style.setProperty("display", "block", "important");
            setTimeout(function() {
                msg.style.setProperty("display", "none", "important");
            }, 3000);
        }

        function copyDirectLink(url) {
            navigator.clipboard.writeText(url);
            alert("Invitation link copied to clipboard!");
        }
    </script>
}
