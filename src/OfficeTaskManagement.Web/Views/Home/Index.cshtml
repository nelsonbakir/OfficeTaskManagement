@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "TaskFlow - AI-Driven Enterprise Task Management";
}

<!-- Glowing backgrounds -->
<div class="position-relative">
    <div class="landing-bg-glow"></div>
    <div class="landing-bg-glow-right"></div>
</div>

<!-- Hero Section -->
<section id="hero" class="hero-section container">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="badge-pill-gradient fade-in-up">
                <i class="fas fa-robot text-primary"></i> Powered by Gemini AI & Stage-Gate Governance
            </div>
            <h1 class="hero-title fade-in-up delay-1">
                Orchestrate Workflows.<br>
                Optimize Capacity.<br>
                <span class="gradient-text">AI-Driven Success.</span>
            </h1>
            <p class="hero-subtitle fade-in-up delay-2">
                TaskFlow is a next-generation project governance platform that connects your codebase to your backlog. Manage resources with RACI matrices, automate approval gates, plan team capacities, and calibrate AI estimations against real-world progress.
            </p>
            <div class="d-flex justify-content-center gap-3 fade-in-up delay-3">
                <a class="btn btn-landing-primary" asp-area="Identity" asp-page="/Account/Register">
                    Get Started Free <i class="fas fa-arrow-right ms-2"></i>
                </a>
                <a class="btn btn-landing-secondary" href="#sandbox">
                    Explore Interactive Sandbox
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Sandbox Section -->
<section id="sandbox" class="sandbox-section container">
    <div class="section-header">
        <span class="text-primary fw-bold text-uppercase" style="font-size: 0.85rem; letter-spacing: 1px;">Interactive Showcase</span>
        <h2>Experience TaskFlow in Action</h2>
        <p>Switch tabs to explore how TaskFlow integrates AI and governance into your day-to-day operations.</p>
    </div>

    <div class="sandbox-container">
        <!-- Tabs -->
        <div class="sandbox-tabs">
            <button class="sandbox-tab-btn active" data-target="#sandbox-onboarding">
                <i class="fas fa-magic"></i> AI Project Onboarding
            </button>
            <button class="sandbox-tab-btn" data-target="#sandbox-raci">
                <i class="fas fa-shield-alt"></i> RACI & Stage-Gates
            </button>
            <button class="sandbox-tab-btn" data-target="#sandbox-capacity">
                <i class="fas fa-chart-gantt"></i> Capacity & Load
            </button>
            <button class="sandbox-tab-btn" data-target="#sandbox-reports">
                <i class="fas fa-file-invoice"></i> PM Risk Radar & Reports
            </button>
        </div>

        <!-- Panes -->
        <!-- Tab 1: AI Onboarding console simulation -->
        <div class="sandbox-pane active" id="sandbox-onboarding">
            <div class="row g-4 align-items-center">
                <div class="col-lg-5">
                    <h3 class="mb-3">Codebase-First Initiation</h3>
                    <p class="text-secondary mb-3">Initialize complex projects instantly by importing your Git repository. TaskFlow's AI parses your codebase and builds the entire hierarchy:</p>
                    <ul class="list-unstyled text-secondary">
                        <li class="mb-2"><i class="fas fa-check-circle text-primary me-2"></i> Generates Epics for major modules</li>
                        <li class="mb-2"><i class="fas fa-check-circle text-primary me-2"></i> Creates User Stories mapped to user requirements</li>
                        <li class="mb-2"><i class="fas fa-check-circle text-primary me-2"></i> Seeds WBS tasks and test cases automatically</li>
                    </ul>
                    <a class="btn btn-landing-primary mt-3" asp-area="Identity" asp-page="/Account/Register">Try Onboarding Wizard</a>
                </div>
                <div class="col-lg-7">
                    <div class="mockup-window">
                        <div class="mockup-header">
                            <div class="mockup-dots">
                                <span class="mockup-dot red"></span>
                                <span class="mockup-dot yellow"></span>
                                <span class="mockup-dot green"></span>
                            </div>
                            <span class="mockup-title">onboard_wizard.log</span>
                            <span style="width: 40px;"></span>
                        </div>
                        <div class="mockup-body">
                            <div class="mockup-console" id="consoleLogs">
                                <div class="console-line info">[INFO] Initializing Git clone for project 'eCommerce-API'...</div>
                                <div class="console-line info">[INFO] Git repository successfully cloned. Analyzing codebase structure...</div>
                                <div class="console-line info">[INFO] 24 controllers and 15 business services detected.</div>
                                <div class="console-line success">[AI] Extracting project Epics...</div>
                                <div class="console-line success">  -> Created Epic: Authentication & Auth (OAuth2/JWT)</div>
                                <div class="console-line success">  -> Created Epic: Cart & Checkout Payment Gateway Integration</div>
                                <div class="console-line success">[AI] Generating User Stories for Cart & Checkout Epic...</div>
                                <div class="console-line success">  -> Mapped User Story: As a shopper, I want to securely pay via Stripe...</div>
                                <div class="console-line info">[INFO] Generating sub-tasks and automated unit test cases...</div>
                                <div class="console-line success">[AI] Created 18 tasks with initial RACI matrix assignments.</div>
                                <div class="console-line success">[SUCCESS] Codebase onboarding complete! Project structural accuracy calibrated at 96.8%.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 2: RACI Kanban -->
        <div class="sandbox-pane" id="sandbox-raci">
            <div class="row g-4 align-items-center">
                <div class="col-lg-5">
                    <h3 class="mb-3">RACI Workflow Engine</h3>
                    <p class="text-secondary mb-3">Enforce process quality and security with RACI-based gate controls. Every task requires designated personnel before moving forward:</p>
                    <ul class="list-unstyled text-secondary">
                        <li class="mb-2"><i class="fas fa-check-circle text-primary me-2"></i> <strong>Responsible:</strong> Assigned developers doing the work</li>
                        <li class="mb-2"><i class="fas fa-check-circle text-primary me-2"></i> <strong>Accountable:</strong> Approver who sign-offs the stage-gate</li>
                        <li class="mb-2"><i class="fas fa-check-circle text-primary me-2"></i> <strong>Consulted / Informed:</strong> Kept in loop automatically</li>
                    </ul>
                    <span class="badge bg-danger bg-opacity-10 text-danger p-2 border border-danger border-opacity-20 d-inline-flex align-items-center gap-2 mt-2">
                        <i class="fas fa-ban"></i> Stage-Gate: Blocked until Accountable user signs off
                    </span>
                </div>
                <div class="col-lg-7">
                    <div class="mockup-window">
                        <div class="mockup-header">
                            <div class="mockup-dots">
                                <span class="mockup-dot red"></span>
                                <span class="mockup-dot yellow"></span>
                                <span class="mockup-dot green"></span>
                            </div>
                            <span class="mockup-title">RACI Governance Board</span>
                            <span style="width: 40px;"></span>
                        </div>
                        <div class="mockup-body">
                            <div class="mockup-kanban-board">
                                <!-- Col 1 -->
                                <div class="mockup-kanban-col">
                                    <div class="mockup-col-header">To Do <span>(2)</span></div>
                                    <div class="mockup-kanban-card">
                                        <div class="mb-1"><span class="mockup-card-raci r">R</span> Setup Stripe SDK</div>
                                        <span class="text-muted" style="font-size: 0.7rem;">Assigned: Alice</span>
                                    </div>
                                    <div class="mockup-kanban-card">
                                        <div class="mb-1"><span class="mockup-card-raci c">C</span> API Docs Review</div>
                                        <span class="text-muted" style="font-size: 0.7rem;">Assigned: Charlie</span>
                                    </div>
                                </div>
                                <!-- Col 2 -->
