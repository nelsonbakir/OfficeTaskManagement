                                    </div>
                                    <div class="mockup-capacity-bar">
                                        <div class="mockup-capacity-fill optimal"></div>
                                    </div>
                                    <span class="text-muted" style="font-size: 0.75rem;">Tasks: Database Migration (12h), Schema Updates (18h)</span>
                                </div>
                                <div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="fw-semibold">Charlie (Junior Dev)</span>
                                        <span class="text-warning fw-semibold">40% Load (Underutilized)</span>
                                    </div>
                                    <div class="mockup-capacity-bar">
