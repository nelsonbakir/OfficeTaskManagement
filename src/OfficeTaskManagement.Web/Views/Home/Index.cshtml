@section Scripts {
    <script>
        $(document).ready(function() {
            // Interactive sandbox tab switching
            $('.sandbox-tab-btn').click(function() {
                var target = $(this).data('target');
                
                // Toggle active class on tab buttons
                $('.sandbox-tab-btn').removeClass('active');
                $(this).addClass('active');
                
                // Toggle active class on panes with animation
                $('.sandbox-pane').removeClass('active');
                $(target).addClass('active');
            });
            
            // Console simulation auto scroll
            var consoleObj = document.getElementById("consoleLogs");
            if (consoleObj) {
                consoleObj.scrollTop = consoleObj.scrollHeight;
            }
        });
    </script>
}
