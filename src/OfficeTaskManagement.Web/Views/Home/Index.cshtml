                                    <div class="mockup-col-header">In Progress <span>(1)</span></div>
                                    <div class="mockup-kanban-card" style="border-left: 2px solid var(--primary);">
                                        <div class="mb-1"><span class="mockup-card-raci r">R</span> Database Migration</div>
                                        <span class="text-muted" style="font-size: 0.7rem;">Assigned: Bob</span>
                                    </div>
                                </div>
                                <!-- Col 3 -->
                                <div class="mockup-kanban-col" style="background: rgba(239, 68, 68, 0.05); border: 1px dashed rgba(239, 68, 68, 0.2);">
