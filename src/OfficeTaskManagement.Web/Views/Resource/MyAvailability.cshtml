@model IEnumerable<OfficeTaskManagement.Models.ResourceAvailabilityBlock>
@using OfficeTaskManagement.Models.Enums

@{
    ViewData["Title"] = "My Availability & Leave Blocks";
    var userId = ViewBag.UserId as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-calendar-check text-primary"></i> My Availability &amp; Leave</h2>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <!-- Add New Block Form -->
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-plus-circle text-success me-2"></i>New Request</h5>
            </div>
            <div class="card-body">
                <form asp-action="Block" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" value="@userId" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Start Date</label>
                        <input type="date" name="startDate" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">End Date</label>
                        <input type="date" name="endDate" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Reason</label>
                        <select name="reason" class="form-select">
                            @foreach (var r in Enum.GetValues<AvailabilityBlockReason>())
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold small">Notes (Optional)</label>
                        <textarea name="notes" class="form-control" rows="3" placeholder="Provide any additional context here..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-send"></i> Submit Request
                    </button>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-md-8">
        <!-- Existing Blocks -->
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-clock-history text-secondary me-2"></i>History</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3 border-0">Date Range</th>
                                    <th class="border-0">Reason</th>
                                    <th class="border-0">Status</th>
                                    <th class="border-0">Notes</th>
                                    <th class="border-0 text-end pe-3">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var blk in Model)
                                {
                                    <tr>
                                        <td class="ps-3 text-nowrap">
                                            @blk.StartDate.ToShortDateString() &rarr; @blk.EndDate.ToShortDateString()
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary text-white">@blk.Reason</span>
                                        </td>
                                        <td>
                                            @if (blk.ApprovalStatus == LeaveApprovalStatus.Approved)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success"><i class="bi bi-check-circle"></i> Approved</span>
                                            }
                                            else if (blk.ApprovalStatus == LeaveApprovalStatus.Rejected)
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger"><i class="bi bi-x-circle"></i> Rejected</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning"><i class="bi bi-hourglass-split"></i> Pending</span>
                                            }
                                        </td>
                                        <td class="text-muted small">
                                            @blk.Notes
                                        </td>
                                        <td class="text-end pe-3">
                                            <form asp-action="DeleteBlock" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@blk.Id" />
                                                <input type="hidden" name="userId" value="@userId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete" onclick="return confirm('Remove this request?')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center p-5 text-muted">
                        <i class="bi bi-inbox text-secondary" style="font-size: 3rem;"></i>
                        <p class="mt-3 fs-5">No leave or availability blocks recorded.</p>
                        <small>Use the form to submit your first request.</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
