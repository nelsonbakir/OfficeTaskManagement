@model OfficeTaskManagement.ViewModels.Analytics.EmployeeDashboard

<div class="mb-4">
    <h3 class="fw-bold" style="color: #252424;"><i class="fas fa-hands-helping text-primary me-2"></i>Welcome back, @Model.EmployeeName!</h3>
    <p class="text-muted small">Here is your workload and active task list for today.</p>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-icon"><i class="fas fa-battery-half"></i></div>
        <div class="metric-label">Remaining Capacity</div>
        @{
            decimal remaining = 40m - Model.CurrentWeekload;
            string capacityColor = remaining < 0 ? "#E81123" : remaining < 8 ? "#ff9800" : "#107C10";
        }
        <p class="metric-value" style="color: @capacityColor;">@remaining.ToString("F1")h</p>
        <div class="metric-subtext">
            @if (remaining < 0)
            {
                <span class="text-danger fw-bold"><i class="fas fa-exclamation-triangle"></i> Overloaded (Max 40h)</span>
            }
            else
            {
                <span>Available for tasks</span>
            }
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon"><i class="fas fa-tasks"></i></div>
        <div class="metric-label d-flex justify-content-between align-items-center">
            Task Completion
            <button class="btn btn-link p-0 text-muted" data-bs-toggle="modal" data-bs-target="#infoCompletionRate" title="Information"><i class="fas fa-info-circle" style="font-size: 0.8rem;"></i></button>
        </div>
        <p class="metric-value">@Model.TaskCompletion.ToString("F0")%</p>
        <div class="progress-bar">
            <div class="progress-fill" style="width: @Model.TaskCompletion%"></div>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon"><i class="fas fa-hourglass-start"></i></div>
        <div class="metric-label">To Do</div>
        <p class="metric-value">@Model.ToDoTasks</p>
        <div class="metric-subtext">@Model.AssignedTasks total assigned</div>
    </div>

    <div class="metric-card">
        <div class="metric-icon"><i class="fas fa-hourglass-half"></i></div>
        <div class="metric-label">In Progress</div>
        <p class="metric-value">@Model.InProgressTasks</p>
        <div class="metric-subtext">active work</div>
    </div>

    <div class="metric-card">
        <div class="metric-icon"><i class="fas fa-check-circle"></i></div>
        <div class="metric-label">Completed</div>
        <p class="metric-value">@Model.CompletedTasks</p>
        <div class="metric-subtext">@(Model.AssignedTasks > 0 ? ((Model.CompletedTasks * 100) / Model.AssignedTasks).ToString("F0") : "0")% done</div>
    </div>

    <div class="metric-card">
        <div class="metric-icon"><i class="fas fa-briefcase"></i></div>
        <div class="metric-label d-flex justify-content-between align-items-center">
            Current Workload
            <button class="btn btn-link p-0 text-muted" data-bs-toggle="modal" data-bs-target="#infoCurrentWorkload" title="Information"><i class="fas fa-info-circle" style="font-size: 0.8rem;"></i></button>
        </div>
        <p class="metric-value" style="color: @(Model.CurrentWeekload > 45m ? "#E81123" : "#0078D4")">@Model.CurrentWeekload.ToString("F1")</p>
        <div class="metric-subtext">hours of work</div>
    </div>
</div>

<!-- My Projects -->
<div class="section-header">
    <i class="fas fa-folder-open"></i>
    <h2>My Allocated Projects (@Model.MyProjects.Count)</h2>
</div>

@if (Model.MyProjects.Any())
{
    <div class="row row-cols-1 row-cols-md-3 g-3">
        @foreach (var project in Model.MyProjects)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm" style="border-radius: 8px; border: 1px solid #EDEBE9 !important; padding: 0.5rem;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="card-title mb-0 fw-bold" style="color: #252424; font-size: 0.95rem;">@project</h6>
                            <span class="badge" style="background-color: #D1ECF1; color: #0C5460; font-size: 0.7rem; font-weight: 600;">Active</span>
                        </div>
                        <p class="text-muted small mb-0"><i class="fas fa-folder me-1"></i> Allocated Project</p>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <i class="fas fa-inbox"></i>
        <p>No projects assigned yet</p>
    </div>
}

<!-- My Tasks -->
<div class="section-header">
    <i class="fas fa-check-circle"></i>
    <h2>My Tasks (@Model.MyTasks.Count)</h2>
</div>

@if (Model.MyTasks.Any())
{
    <div class="table-card">
        <table>
            <thead>
                <tr>
                    <th>Task</th>
                    <th>Project</th>
                    <th>Sprint</th>
                    <th>Status</th>
                    <th>Due Date</th>
                    <th>Hours</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in Model.MyTasks.OrderBy(t => t.DueDate))
                {
                    <tr>
                        <td><strong>@task.TaskTitle</strong></td>
                        <td>@task.ProjectName</td>
                        <td>@(string.IsNullOrEmpty(task.SprintName) ? "-" : task.SprintName)</td>
                        <td>
                            <span class="status-badge @GetStatusClass(task.Status)">
                                @task.Status
                            </span>
                        </td>
                        <td>@(task.DueDate.HasValue ? task.DueDate.Value.ToString("MMM dd, yyyy") : "-")</td>
                        <td>@task.EstimatedHours.ToString("F1") hrs</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="empty-state">
        <i class="fas fa-inbox"></i>
        <p>No tasks assigned yet</p>
    </div>
}

<!-- Current Sprints -->
<div class="section-header">
    <i class="fas fa-rocket"></i>
    <h2>Current Sprints (@Model.CurrentSprints)</h2>
</div>

<p style="color: #605E5C; margin-bottom: 1rem;">
    You are participating in @Model.CurrentSprints sprint@(Model.CurrentSprints != 1 ? "s" : "").
</p>

@functions {
    private string GetStatusClass(string status)
    {
        return status switch
        {
            "ToDo" => "status-on-track",
            "InProgress" => "status-active",
            "Tested" => "status-on-track",
            "Done" => "status-on-track",
            _ => "status-on-track"
        };
    }
}
