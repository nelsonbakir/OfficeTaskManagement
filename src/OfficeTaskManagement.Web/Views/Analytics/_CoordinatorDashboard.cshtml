@model OfficeTaskManagement.ViewModels.Analytics.DashboardViewModel
@{
    var metrics = Model.CoordinatorMetrics!;
}

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-icon"><i class="fas fa-tasks"></i></div>
        <div class="metric-label d-flex align-items-center gap-1">
            Total Task Flow
            <button class="btn btn-link p-0 text-muted lh-1" data-bs-toggle="modal" data-bs-target="#infoTotalTaskFlow" title="Information"><i class="fas fa-info-circle" style="font-size: 0.8rem;"></i></button>
        </div>
        <p class="metric-value">@metrics.TotalTasks</p>
        <div class="metric-subtext">
            @if (metrics.UnassignedTasks > 0)
            {
                <span class="text-danger fw-bold"><i class="fas fa-exclamation-triangle"></i> @metrics.UnassignedTasks unassigned</span>
            }
            else
            {
                <span class="text-success"><i class="fas fa-check-circle"></i> All assigned</span>
            }
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon"><i class="fas fa-check-circle"></i></div>
        <div class="metric-label d-flex align-items-center gap-1">
            Task Completion
            <button class="btn btn-link p-0 text-muted lh-1" data-bs-toggle="modal" data-bs-target="#infoCompletionRate" title="Information"><i class="fas fa-info-circle" style="font-size: 0.8rem;"></i></button>
        </div>
        <p class="metric-value">@metrics.TaskCompletionRate.ToString("F0")%</p>
        <div class="progress-bar">
            <div class="progress-fill" style="width: @metrics.TaskCompletionRate%"></div>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon"><i class="fas fa-hourglass-half"></i></div>
        <div class="metric-label d-flex align-items-center gap-1">
            In Progress
            <button class="btn btn-link p-0 text-muted lh-1" data-bs-toggle="modal" data-bs-target="#infoInProgressTasks" title="Information"><i class="fas fa-info-circle" style="font-size: 0.8rem;"></i></button>
        </div>
        <p class="metric-value">@metrics.InProgressTasks</p>
        <div class="metric-subtext">active dev work</div>
    </div>

    <div class="metric-card">
        @{
            int overcommitted = Model.SprintCapacities.Count(c => c.Delta < 0);
            string scopeHealthColor = overcommitted > 0 ? "#E81123" : "#107C10";
        }
        <div class="metric-icon" style="color: @scopeHealthColor;"><i class="fas fa-balance-scale"></i></div>
        <div class="metric-label d-flex align-items-center gap-1">
            Sprint Scope Health
            <button class="btn btn-link p-0 text-muted lh-1" data-bs-toggle="modal" data-bs-target="#infoSprintCapacity" title="Information"><i class="fas fa-info-circle" style="font-size: 0.8rem;"></i></button>
        </div>
        <p class="metric-value" style="color: @scopeHealthColor;">
            @(overcommitted > 0 ? $"{overcommitted} Over" : "Healthy")
        </p>
        <div class="metric-subtext">
            @if (overcommitted > 0)
            {
                <span class="text-danger"><i class="fas fa-exclamation-triangle"></i> Sprints overcommitted</span>
            }
            else
            {
                <span>Sprints fit team capacity</span>
            }
        </div>
    </div>

    <div class="metric-card">
        @{
            string overdueColor = metrics.OverdueTasks > 0 ? "#E81123" : "#107C10";
        }
        <div class="metric-icon" style="color: @overdueColor;"><i class="fas fa-clock"></i></div>
        <div class="metric-label d-flex align-items-center gap-1">
            Overdue Tasks
            <button class="btn btn-link p-0 text-muted lh-1" data-bs-toggle="modal" data-bs-target="#infoOverdueTasks" title="Information"><i class="fas fa-info-circle" style="font-size: 0.8rem;"></i></button>
        </div>
        <p class="metric-value" style="color: @overdueColor;">@metrics.OverdueTasks</p>
        <div class="metric-subtext">past target deadlines</div>
    </div>
</div>

<!-- Sprint Capacity Planning -->
<div class="section-header">
    <i class="fas fa-balance-scale"></i>
    <h2>Active Sprint Capacity Planning</h2>
</div>

@if(!Model.SprintCapacities.Any())
{
    <div class="empty-state">
        <i class="fas fa-info-circle"></i>
        <p>No active sprints to plan capacity</p>
    </div>
}
else
{
    <div class="table-card">
        <table>
            <thead>
                <tr>
                    <th>Sprint</th>
                    <th>Planned Capacity</th>
                    <th>Task Demand</th>
                    <th>Delta / Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var cap in Model.SprintCapacities)
                {
                    <tr>
                        <td><strong>@cap.SprintName</strong></td>
                        <td>@cap.PlannedCapacity.ToString("0") hrs</td>
                        <td>@cap.TaskDemand.ToString("0.0") hrs</td>
                        <td>
                            @if(cap.Delta < 0)
                            {
                                <span class="badge" style="background: #FDE7E9; color: #A4262C; font-weight: 600;">@Math.Abs(cap.Delta).ToString("0.0") hrs Overcommitted</span>
                            }
                            else
                            {
                                <span class="badge" style="background: #DFF6DD; color: #107C10; font-weight: 600;">+@cap.Delta.ToString("0") hrs Available</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Blockers & Stuck Tasks -->
<div class="section-header">
    <i class="fas fa-ban"></i>
    <h2>Blockers &amp; Paused Tasks (@metrics.Blockers.Count)</h2>
</div>

@if (metrics.Blockers.Any())
{
    <div class="table-card">
        <table>
            <thead>
                <tr>
                    <th>Task Title</th>
                    <th>Assignee</th>
                    <th>Paused Date</th>
                    <th>Blocker Reason</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var blocker in metrics.Blockers)
                {
                    <tr>
                        <td><strong>@blocker.TaskTitle</strong></td>
                        <td>@blocker.AssigneeName</td>
                        <td>@blocker.CreatedDate.ToString("MMM dd, yyyy")</td>
                        <td><span class="text-danger"><i class="fas fa-comment-dots"></i> @blocker.BlockedReason</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="empty-state">
        <i class="fas fa-check-circle" style="color: #107C10;"></i>
        <p>No active blockers identified</p>
    </div>
}

<!-- Sprint Progress -->
<div class="section-header">
    <i class="fas fa-rocket"></i>
    <h2>Sprint Progress</h2>
</div>

@if (metrics.SprintProgress.Any())
{
    @foreach (var sprint in metrics.SprintProgress)
    {
        <div class="list-item">
            <div class="list-item-content" style="flex: 1;">
                <h3>@sprint.SprintName</h3>
                <p>@sprint.CompletedTasks / @sprint.TotalTasks tasks completed • @sprint.DaysRemaining days remaining</p>
            </div>
            <div style="min-width: 150px;">
                <div class="progress-bar">
                    <div class="progress-fill" style="width: @sprint.Progress%"></div>
                </div>
                <span style="font-size: 0.85rem; color: #605E5C;">@sprint.Progress.ToString("F0")%</span>
            </div>
        </div>
    }
}
else
{
    <div class="empty-state">
        <i class="fas fa-inbox"></i>
        <p>No active sprints</p>
    </div>
}

<!-- Upcoming Deadlines -->
<div class="section-header">
    <i class="fas fa-calendar"></i>
    <h2>Upcoming Deadlines (Next 7 Days)</h2>
</div>

@if (metrics.UpcomingDeadlines.Any())
{
    @foreach (var task in metrics.UpcomingDeadlines)
    {
        <div class="list-item">
            <div class="list-item-content">
                <h3>@task.TaskTitle</h3>
                <p>
                    <i class="fas fa-user-circle"></i> @task.AssigneeName •
                    <i class="fas fa-calendar"></i> @task.DueDate.ToString("MMM dd, yyyy")
                </p>
            </div>
            <span class="status-badge status-on-track">@task.Status</span>
        </div>
    }
}
else
{
    <div class="empty-state">
        <i class="fas fa-inbox"></i>
        <p>No upcoming deadlines</p>
    </div>
}
