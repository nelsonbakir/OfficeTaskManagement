@model OfficeTaskManagement.Models.Project
@using OfficeTaskManagement.Services
@inject IMediaService MediaService

@{ 
    ViewData["Title"] = Model.Name;
    var sprints = Model.Sprints ?? new List<OfficeTaskManagement.Models.Sprint>();
    var tasks = sprints.SelectMany(s => s.Tasks).ToList();
}

<style>
    .project-header {
        background: white;
        border-bottom: 1px solid #EDEBE9;
        padding: 2rem;
        margin: -2rem -2rem 2rem -2rem;
        border-radius: 6px 6px 0 0;
    }

    .project-title-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .project-title-container {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .project-logo-large {
        width: 64px;
        height: 64px;
        object-fit: contain;
        border: 1px solid #EDEBE9;
        border-radius: 8px;
        padding: 4px;
        background: white;
    }

    .project-title-section h1 {
        font-size: 2rem;
        font-weight: 600;
        margin: 0;
    }

    .project-header-actions {
        display: flex;
        gap: 0.75rem;
    }

    .project-info {
        display: grid;
        grid-template-columns: auto 1fr auto 1fr;
        gap: 2rem;
        font-size: 0.9rem;
        margin-top: 1rem;
    }

    .info-item {
        display: flex;
        flex-direction: column;
    }

    .info-label {
        color: #605E5C;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
    }

    .info-value {
        color: #252424;
        font-weight: 500;
    }

    /* Tabs */
    .nav-tabs {
        border-bottom: 1px solid #EDEBE9;
        background: white;
        padding: 0 2rem;
        margin: 0 -2rem 0 -2rem;
        border-radius: 0;
    }

    .nav-tabs .nav-link {
        color: #605E5C;
        border: none;
        border-bottom: 2px solid transparent;
        padding: 1rem 1.5rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .nav-tabs .nav-link:hover {
        color: #0078D4;
        border-bottom-color: #0078D4;
    }

    .nav-tabs .nav-link.active {
        color: #0078D4;
        border-bottom-color: #0078D4;
        background: transparent;
    }

    /* Sections */
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .section-header h2 {
        font-size: 1.3rem;
        font-weight: 600;
        margin: 0;
    }

    .section-actions {
        display: flex;
        gap: 0.75rem;
    }

    /* Sprint Card */
    .sprint-card {
        background: white;
        border: 1px solid #EDEBE9;
        border-radius: 6px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        transition: all 0.2s ease;
    }

    .sprint-card:hover {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .sprint-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .sprint-name {
        font-size: 1.1rem;
        font-weight: 600;
        color: #0078D4;
        margin: 0;
    }

    .sprint-status {
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .sprint-status.active {
        background: #D4EDDA;
        color: #155724;
    }

    .sprint-status.planning {
        background: #FFF3CD;
        color: #856404;
    }

    .sprint-status.completed {
        background: #D1ECF1;
        color: #0C5460;
    }

    .sprint-tasks {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-top: 1rem;
    }

    .task-item {
        background: #F3F2F1;
        padding: 0.75rem 1rem;
        border-radius: 4px;
        border-left: 3px solid #0078D4;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: all 0.2s ease;
    }

    .task-item:hover {
        background: #EDEBE9;
    }

    .task-info {
        flex: 1;
    }

    .task-title {
        font-weight: 500;
        color: #252424;
        margin-bottom: 0.25rem;
    }

    .task-meta {
        font-size: 0.8rem;
        color: #605E5C;
    }

    .task-actions {
        display: flex;
        gap: 0.5rem;
    }

    .quick-action-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: 1px solid #EDEBE9;
        background: white;
        color: #605E5C;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
        font-size: 0.85rem;
    }

    .quick-action-btn:hover {
        background: white;
        color: #0078D4;
    }

    .empty-list {
        text-align: center;
        padding: 2rem;
        color: #605E5C;
        background: white;
        border: 1px dashed #EDEBE9;
        border-radius: 6px;
    }

    .empty-list i {
        font-size: 2rem;
        color: #EDEBE9;
        display: block;
        margin-bottom: 0.5rem;
    }

    .inline-form {
        background: #F3F2F1;
        border: 1px solid #EDEBE9;
        border-radius: 6px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .inline-form-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
    }

    .inline-form-row:last-child {
        margin-bottom: 0;
    }

    .form-control-inline {
        border: 1px solid #EDEBE9;
        padding: 0.625rem 0.875rem;
        border-radius: 4px;
        font-size: 0.9rem;
    }

    .form-control-inline:focus {
        outline: none;
        border-color: #0078D4;
        box-shadow: 0 0 0 3px rgba(0, 120, 212, 0.1);
    }

    .btn-inline {
        padding: 0.625rem 1rem;
        border-radius: 4px;
        border: none;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-inline-primary {
        background: #0078D4;
        color: white;
    }

    .btn-inline-primary:hover {
        background: #005A9E;
    }

    .btn-inline-secondary {
        background: white;
        border: 1px solid #EDEBE9;
        color: #252424;
    }

    .btn-inline-secondary:hover {
        background: #F3F2F1;
    }

    .attachment-card {
        display: flex;
        align-items: center;
        padding: 1rem;
        border: 1px solid #EDEBE9;
        border-radius: 6px;
        margin-bottom: 0.75rem;
        transition: all 0.2s ease;
        text-decoration: none;
        color: inherit;
    }

    .attachment-card:hover {
        background: #F3F2F1;
        border-color: #0078D4;
    }

    .attachment-icon {
        font-size: 1.5rem;
        color: #0078D4;
        margin-right: 1.25rem;
    }

    .attachment-details {
        flex: 1;
    }

    .attachment-name {
        font-weight: 600;
        display: block;
    }

    .attachment-meta {
        font-size: 0.8rem;
        color: #605E5C;
    }
</style>

<div class="project-header">
    <div class="project-title-section">
        <div class="project-title-container">
            @if (!string.IsNullOrEmpty(Model.LogoPath))
            {
                <img src="@MediaService.GetUrl(Model.LogoPath)" alt="@Model.Name Logo" class="project-logo-large" />
            }
            <h1>
                @if (string.IsNullOrEmpty(Model.LogoPath))
                {
                    <i class="fas fa-folder-open"></i>
                }
                @Model.Name
            </h1>
        </div>
        <div class="project-header-actions">
            @if(await PermSvc.HasPermissionAsync(User, Permissions.ProjectsManage)) {
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-pen-to-square"></i> Edit
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <div class="project-info">
        <div class="info-item">
            <span class="info-label">Owner</span>
            <div style="display: flex; align-items: center; gap: 0.5rem;" class="info-value">
                @if (Model.CreatedBy != null && !string.IsNullOrEmpty(Model.CreatedBy.AvatarPath))
                {
                    <img src="@MediaService.GetUrl(Model.CreatedBy.AvatarPath)" style="width: 24px; height: 24px; border-radius: 50%; object-fit: cover;" alt="@Model.CreatedBy.FullName" />
                }
                else
                {
                    <i class="fas fa-user-circle text-muted"></i>
                }
                @Html.DisplayFor(model => model.CreatedBy.FullName)
            </div>
        </div>
        <div class="info-item">
            <span class="info-label">Sprints</span>
            <span class="info-value">@sprints.Count</span>
        </div>
        <div class="info-item">
            <span class="info-label">Active Tasks</span>
            <span class="info-value">@tasks.Where(t => t.Status != OfficeTaskManagement.Models.Enums.TaskStatus.Done).Count()</span>
        </div>
        <div class="info-item">
            <span class="info-label">Completion</span>
            <span class="info-value">@(tasks.Any() ? Math.Round((tasks.Count(t => t.Status == OfficeTaskManagement.Models.Enums.TaskStatus.Done) * 100) / (double)tasks.Count()) : 0)%</span>
        </div>
    </div>
</div>

@if (TempData["SkillWarning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert" style="margin-bottom: 2rem;">
        <i class="fas fa-exclamation-triangle me-2"></i> @TempData["SkillWarning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ResourceWarning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert" style="margin-bottom: 2rem;">
        <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ResourceWarning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if(!string.IsNullOrEmpty(Model.Description)) {
    <div style="background: white; padding: 1.5rem; border-radius: 6px; margin-bottom: 2rem; border: 1px solid #EDEBE9;">
        <p style="margin: 0; color: #605E5C; line-height: 1.6;">@Model.Description</p>
    </div>
}

<ul class="nav nav-tabs">
    <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="#sprints">
            <i class="fas fa-rocket"></i> Sprints
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#epics">
            <i class="fas fa-layer-group"></i> Epics
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tasks">
            <i class="fas fa-check-circle"></i> All Tasks
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#allocations">
            <i class="fas fa-users-gear"></i> Resource Allocations
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#attachments">
            <i class="fas fa-paperclip"></i> Attachments (@(Model.Attachments?.Count ?? 0))
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#codebase">
            <i class="fas fa-code"></i> Codebase RAG
        </a>
    </li>
    @if (await PermSvc.HasPermissionAsync(User, Permissions.BudgetView))
    {
        <li class="nav-item">
            <a asp-action="Budget" asp-route-id="@Model.Id" class="nav-link">
                <i class="bi bi-wallet2"></i> Budget & Costs
            </a>
        </li>
    }
</ul>

<div class="tab-content" style="background: white; padding: 2rem;">
    <!-- Resource Allocations Tab -->
    <div id="allocations" class="tab-pane fade">
        <div class="section-header" style="margin-top: 1.5rem;">
            <h2>Project Allocations</h2>
            @if(await PermSvc.HasPermissionAsync(User, Permissions.ProjectsManage)) {
                <a asp-controller="Resource" asp-action="Allocate" asp-route-projectId="@Model.Id" class="btn btn-primary btn-sm">
                    <i class="fas fa-user-plus"></i> Allocate Resource
                </a>
            }
        </div>

        @if (Model.ResourceAllocations != null && Model.ResourceAllocations.Any()) {
            <div class="table-responsive" style="margin-top: 1.5rem;">
                <table class="table table-hover">
                    <thead class="bg-light">
                        <tr>
                            <th>Resource</th>
                            <th>Role</th>
                            <th class="text-center">Allocation %</th>
                            <th>Period</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var allocation in Model.ResourceAllocations) {
                            <tr>
                                <td class="align-middle">
                                    <div class="d-flex align-items-center gap-2">
                                        @if (allocation.User != null && !string.IsNullOrEmpty(allocation.User.AvatarPath)) {
                                            <img src="@MediaService.GetUrl(allocation.User.AvatarPath)" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;" alt="@allocation.User.FullName" />
                                        } else {
                                            <i class="fas fa-user-circle text-muted fs-4"></i>
                                        }
                                        <div class="fw-medium">@(allocation.User?.FullName ?? "Unknown")</div>
                                    </div>
                                </td>
                                <td class="align-middle">@allocation.ProjectRole</td>
                                <td class="align-middle text-center">
                                    <div class="progress" style="height: 10px; width: 80px; margin: 0 auto 5px auto;">
                                        <div class="progress-bar bg-success" role="progressbar" style="width: @allocation.AllocationPercentage%"></div>
                                    </div>
                                    <small class="text-muted">@allocation.AllocationPercentage%</small>
                                </td>
                                <td class="align-middle">
                                    <div style="font-size: 0.85rem;">@allocation.StartDate.ToString("MMM dd, yyyy") -</div>
                                    <div class="text-muted small">@(allocation.EndDate?.ToString("MMM dd, yyyy") ?? "Continuous")</div>
                                </td>
                                <td class="align-middle text-end">
                                    @if(await PermSvc.HasPermissionAsync(User, Permissions.ProjectsManage)) {
                                        <div class="d-flex justify-content-end gap-1">
                                            <a asp-controller="Resource" asp-action="EditAllocation" asp-route-id="@allocation.Id" class="quick-action-btn" title="Edit Allocation">
                                                <i class="fas fa-pen"></i>
                                            </a>
                                            <form asp-controller="Resource" asp-action="DeleteAllocation" asp-route-id="@allocation.Id" method="post" onsubmit="return confirm('Are you sure you want to remove this allocation?');" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="quick-action-btn text-danger" style="border: 1px solid #FDE7E9;" title="Delete Allocation">
                                                    <i class="fas fa-trash-can"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        } else {
            <div class="empty-list" style="margin-top: 1.5rem;">
                <i class="fas fa-users-gear"></i>
                No formal resource allocations for this project
                @if(await PermSvc.HasPermissionAsync(User, Permissions.ProjectsManage)) {
                    <p style="margin-top: 0.5rem;">
                        <a asp-controller="Resource" asp-action="Allocate" asp-route-projectId="@Model.Id" class="btn btn-primary btn-sm">Allocate your first resource</a>
                    </p>
                }
            </div>
        }
    </div>
    <!-- Attachments Tab -->
    <div id="attachments" class="tab-pane fade">
        <div class="section-header" style="margin-top: 1.5rem;">
            <h2>Project Attachments</h2>
            @if(await PermSvc.HasPermissionAsync(User, Permissions.ProjectsManage)) {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-plus"></i> Add Attachments
                </a>
            }
        </div>

        @if (Model.Attachments != null && Model.Attachments.Any()) {
            <div style="margin-top: 1.5rem;">
                @foreach (var attachment in Model.Attachments) {
                    <a href="@MediaService.GetUrl(attachment.FilePath)" target="_blank" class="attachment-card">
                        <div class="attachment-icon">
                            @if (attachment.FileName.EndsWith(".pdf")) { <i class="fas fa-file-pdf"></i> }
                            else if (attachment.FileName.EndsWith(".jpg") || attachment.FileName.EndsWith(".jpeg") || attachment.FileName.EndsWith(".png")) { <i class="fas fa-file-image"></i> }
                            else { <i class="fas fa-file"></i> }
                        </div>
                        <div class="attachment-details">
                            <span class="attachment-name">@attachment.FileName</span>
                            <span class="attachment-meta">
                                Uploaded by @(attachment.UploadedBy?.FullName ?? "Unknown") on @attachment.UploadedAt.ToString("MMM dd, yyyy")
                            </span>
                        </div>
                        <i class="fas fa-external-link-alt text-muted"></i>
                    </a>
                }
            </div>
        } else {
            <div class="empty-list" style="margin-top: 1.5rem;">
                <i class="fas fa-paperclip"></i>
                No attachments yet
            </div>
        }
    </div>
    <!-- Epics Tab -->
    <div id="epics" class="tab-pane fade">
        @if(await PermSvc.HasPermissionAsync(User, Permissions.ProjectsManage)) {
            <div class="section-header" style="margin-top: 1.5rem;">
                <h2>Epics</h2>
                <a asp-controller="Epics" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> New Epic
                </a>
            </div>
        }

        @if (Model.Epics != null && Model.Epics.Any()) {
            <div class="project-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; margin-top: 1.5rem;">
                @foreach (var epic in Model.Epics) {
                    <div class="project-card" style="background: white; border: 1px solid #EDEBE9; border-radius: 6px; padding: 1.5rem; transition: all 0.2s ease; position: relative;">
                        <a asp-controller="Epics" asp-action="Details" asp-route-id="@epic.Id" class="project-name" style="font-size: 1.1rem; font-weight: 600; color: #0078D4; text-decoration: none; display: block; margin-bottom: 0.5rem;">
                            @epic.Name
                        </a>
                        <p class="project-description" style="font-size: 0.9rem; color: #605E5C; margin: 0 0 1rem 0; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @epic.Description
                        </p>
                        <div class="project-actions" style="position: absolute; top: 1rem; right: 1rem; display: flex; gap: 0.5rem;">
                             <a asp-controller="Epics" asp-action="Edit" asp-route-id="@epic.Id" class="quick-action-btn" title="Edit">
                                 <i class="fas fa-pen-to-square"></i>
                             </a>
                        </div>
                    </div>
                }
            </div>
        } else {
            <div class="empty-list" style="margin-top: 1.5rem; text-align: center; padding: 2rem; color: #605E5C; border: 1px dashed #EDEBE9; border-radius: 6px;">
                <i class="fas fa-layer-group" style="font-size: 2rem; color: #EDEBE9; display: block; margin-bottom: 0.5rem;"></i>
                No epics yet
                @if(await PermSvc.HasPermissionAsync(User, Permissions.ProjectsManage)) {
                    <p style="margin-top: 0.5rem;">
                        <a asp-controller="Epics" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-primary btn-sm">
                            Create your first epic
                        </a>
                    </p>
                }
            </div>
        }
    </div>
    <!-- Sprints Tab -->
    <div id="sprints" class="tab-pane fade show active">
        @if(await PermSvc.HasPermissionAsync(User, Permissions.ProjectsManage)) {
            <div class="section-header" style="margin-top: 1.5rem;">
                <h2>Sprints</h2>
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="collapse" data-bs-target="#newSprintForm">
                    <i class="fas fa-plus"></i> New Sprint
                </button>
            </div>

            <div id="newSprintForm" class="collapse">
                <form asp-controller="Sprints" asp-action="Create" method="post" class="inline-form">
                    <input type="hidden" name="projectId" value="@Model.Id" />
                    <div class="inline-form-row">
                        <input type="text" name="name" placeholder="Sprint name" class="form-control-inline" required />
                        <button type="submit" class="btn-inline btn-inline-primary">Create</button>
                    </div>
                </form>
            </div>
        }

        @if (sprints.Any()) {
            @foreach (var sprint in sprints) {
                <div class="sprint-card">
                    <div class="sprint-header">
                        <h3 class="sprint-name">@sprint.Name</h3>
                        <div class="sprint-status active" style="text-align: center;">
                            @(sprint.IsActive ? "Active" : "Completed")
                        </div>
                    </div>

                    @if (sprint.Tasks.Any()) {
                        <div class="sprint-tasks">
                            @foreach (var task in sprint.Tasks) {
                                <div class="task-item">
                                    <div class="task-info">
                                        <div class="task-title">@task.Title</div>
                                        <div class="task-meta">
                                            @if(task.Assignee != null) {
                                                <i class="fas fa-user-circle"></i> @task.Assignee.FullName
                                                <span style="margin: 0 0.5rem;">•</span>
                                            }
                                            <span style="padding: 2px 6px; background: #F3F2F1; border-radius: 3px; font-size: 0.75rem;">
                                                @task.Status
                                            </span>
                                        </div>
                                    </div>
                                    <div class="task-actions">
                                        <a asp-controller="TaskItems" asp-action="Edit" asp-route-id="@task.Id" class="quick-action-btn" title="Edit">
                                            <i class="fas fa-pen-to-square"></i>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    } else {
                        <div class="empty-list">
                            <i class="fas fa-inbox"></i>
                            No tasks in this sprint
                        </div>
                    }
                </div>
            }
        } else {
            <div class="empty-list" style="margin-top: 1.5rem;">
                <i class="fas fa-inbox"></i>
                No sprints yet
                @if(await PermSvc.HasPermissionAsync(User, Permissions.ProjectsManage)) {
                    <p style="margin-top: 0.5rem;">
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="collapse" data-bs-target="#newSprintForm">
                            Create your first sprint
                        </button>
                    </p>
                }
            </div>
        }
    </div>

    <!-- All Tasks Tab -->
    <div id="tasks" class="tab-pane fade">
        @if(await PermSvc.HasPermissionAsync(User, Permissions.ProjectsManage)) {
            <div class="section-header" style="margin-top: 1.5rem;">
                <h2>All Tasks</h2>
                <a asp-controller="TaskItems" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> New Task
                </a>
            </div>
        }

        @if (tasks.Any()) {
            <div class="sprint-tasks" style="margin-top: 1.5rem;">
                @foreach (var task in tasks.OrderByDescending(t => t.CreatedAt)) {
                    <div class="task-item">
                        <div class="task-info">
                            <div class="task-title">@task.Title</div>
                            <div class="task-meta">
                                @if(task.Sprint != null) {
                                    <i class="fas fa-rocket"></i> @task.Sprint.Name
                                    <span style="margin: 0 0.5rem;">•</span>
                                }
                                @if(task.Assignee != null) {
                                    <i class="fas fa-user-circle"></i> @task.Assignee.FullName
                                    <span style="margin: 0 0.5rem;">•</span>
                                }
                                <span style="padding: 2px 6px; background: #F3F2F1; border-radius: 3px; font-size: 0.75rem;">
                                    @task.Status
                                </span>
                            </div>
                        </div>
                        <div class="task-actions">
                            <a asp-controller="TaskItems" asp-action="Edit" asp-route-id="@task.Id" class="quick-action-btn" title="Edit">
                                <i class="fas fa-pen-to-square"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        } else {
            <div class="empty-list" style="margin-top: 1.5rem;">
                <i class="fas fa-inbox"></i>
                No tasks yet
                @if(await PermSvc.HasPermissionAsync(User, Permissions.ProjectsManage)) {
                    <p style="margin-top: 0.5rem;">
                        <a asp-controller="TaskItems" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-primary btn-sm">
                            Create your first task
                        </a>
                    </p>
                }
            </div>
        }
    </div>

    <!-- Codebase RAG Tab -->
    <div id="codebase" class="tab-pane fade">
        <div class="section-header" style="margin-top: 1.5rem;">
            <h2>Codebase RAG Grounding</h2>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 300px; gap: 2rem; margin-top: 1.5rem;">
            <!-- Main Content -->
            <div>
                <div style="background: #F3F2F1; border: 1px solid #EDEBE9; border-radius: 6px; padding: 1.5rem; margin-bottom: 1.5rem;">
                    <h3 style="font-size: 1rem; font-weight: 600; margin-top: 0; margin-bottom: 1rem; color: #252424;">
                        <i class="fas fa-folder-open text-primary"></i> Repository Configuration
                    </h3>
                    <div style="display: grid; grid-template-columns: auto 1fr; gap: 0.75rem 1.5rem; font-size: 0.9rem;">
                        <span style="font-weight: 600; color: #605E5C;">Local Path:</span>
                        <span>@(string.IsNullOrEmpty(Model.RepositoryPath) ? "(Not configured)" : Model.RepositoryPath)</span>

                        <span style="font-weight: 600; color: #605E5C;">Git URL:</span>
                        <span>@(string.IsNullOrEmpty(Model.RepositoryUrl) ? "(Not configured)" : Model.RepositoryUrl)</span>
                    </div>
                </div>

                <div id="codebase-status-card" style="border: 1px solid #EDEBE9; border-radius: 6px; padding: 1.5rem; background: white;">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
                        <h3 style="font-size: 1.1rem; font-weight: 600; margin: 0; color: #252424;">
                            <i class="fas fa-code text-primary"></i> Index Status
                        </h3>
                        <span id="codebase-sync-badge" class="badge" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">Loading...</span>
                    </div>

                    <div id="codebase-sync-warning" class="alert alert-warning" style="display: none; font-size: 0.9rem; align-items: center; gap: 0.5rem; padding: 0.75rem 1.25rem;">
                        <i class="fas fa-exclamation-triangle"></i> Local changes detected since last indexing. Re-indexing is recommended.
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 1.5rem;">
                        <div style="background: #F3F2F1; padding: 1rem; border-radius: 4px; text-align: center;">
                            <span style="display: block; font-size: 0.8rem; color: #605E5C; text-transform: uppercase;">Indexed Chunks</span>
                            <span id="codebase-chunks" style="font-size: 1.5rem; font-weight: 600; color: #252424;">-</span>
                        </div>
                        <div style="background: #F3F2F1; padding: 1rem; border-radius: 4px; text-align: center;">
                            <span style="display: block; font-size: 0.8rem; color: #605E5C; text-transform: uppercase;">Tokens Used</span>
                            <span id="codebase-tokens" style="font-size: 1.25rem; font-weight: 600; color: #252424; display: block; margin-top: 0.2rem;">-</span>
                        </div>
                        <div style="background: #F3F2F1; padding: 1rem; border-radius: 4px; text-align: center;">
                            <span style="display: block; font-size: 0.8rem; color: #605E5C; text-transform: uppercase;">Estimated Cost</span>
                            <span id="codebase-cost" style="font-size: 1.5rem; font-weight: 600; color: #252424;">-</span>
                        </div>
                    </div>

                    <div style="font-size: 0.85rem; color: #605E5C;">
                        <strong>Last Sync Date:</strong> <span id="codebase-last-sync">-</span>
                    </div>
                </div>
            </div>

            <!-- Sidebar Actions -->
            <div>
                <div style="background: #F3F2F1; border: 1px solid #EDEBE9; border-radius: 6px; padding: 1.25rem;">
                    <h3 style="font-size: 0.9rem; font-weight: 600; color: #252424; margin: 0 0 1rem 0; text-transform: uppercase; letter-spacing: 0.5px;">Actions</h3>
                    
                    @if (string.IsNullOrEmpty(Model.RepositoryPath))
                    {
                        <div class="alert alert-info" style="font-size: 0.8rem; margin-bottom: 1rem; padding: 0.5rem 0.75rem;">
                            <i class="fas fa-info-circle"></i> Set a repository path in Project Settings to enable RAG indexing.
                        </div>
                    }
                    
                    <button id="btn-sync-codebase" class="btn btn-primary" style="width: 100%; margin-bottom: 0.75rem; background: #0078D4; border-color: #0078D4;" @(string.IsNullOrEmpty(Model.RepositoryPath) ? "disabled" : "")>
                        <i class="fas fa-sync-alt"></i> Sync Index Now
                    </button>
                    <button id="btn-purge-codebase" class="btn btn-outline-danger" style="width: 100%;" @(string.IsNullOrEmpty(Model.RepositoryPath) ? "disabled" : "")>
                        <i class="fas fa-trash-alt"></i> Purge Index
                    </button>
                </div>
            </div>
        </div>

        <script>
            document.addEventListener("DOMContentLoaded", function() {
                const projectId = @Model.Id;
                const syncBtn = document.getElementById("btn-sync-codebase");
                const purgeBtn = document.getElementById("btn-purge-codebase");

                async function fetchStatus() {
                    try {
                        const response = await fetch(`/api/agent/index-status/${projectId}`);
                        if (!response.ok) throw new Error("Failed to fetch status");
                        const data = await response.json();

                        document.getElementById("codebase-chunks").textContent = data.chunkCount.toLocaleString();
                        document.getElementById("codebase-tokens").textContent = (data.inputTokens + data.outputTokens).toLocaleString();
                        document.getElementById("codebase-cost").textContent = "৳ " + data.estimatedCostBdt.toFixed(2);
                        
                        if (data.lastIndexedAt) {
                            document.getElementById("codebase-last-sync").textContent = new Date(data.lastIndexedAt).toLocaleString();
                        } else {
                            document.getElementById("codebase-last-sync").textContent = "Never";
                        }

                        const badge = document.getElementById("codebase-sync-badge");
                        const warning = document.getElementById("codebase-sync-warning");
                        
                        if (data.chunkCount === 0) {
                            badge.textContent = "Not Indexed";
                            badge.className = "badge bg-secondary text-white";
                            warning.style.display = "none";
                        } else if (data.needsSync) {
                            badge.textContent = "Needs Sync";
                            badge.className = "badge bg-warning text-dark";
                            warning.style.display = "flex";
                        } else {
                            badge.textContent = "Up to date";
                            badge.className = "badge bg-success text-white";
                            warning.style.display = "none";
                        }
                    } catch (error) {
                        console.error("Error fetching codebase status:", error);
                    }
                }

                if (syncBtn) {
                    syncBtn.addEventListener("click", async function() {
                        syncBtn.disabled = true;
                        syncBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Syncing...';
                        try {
                            const response = await fetch(`/api/agent/index-project/${projectId}`, { method: "POST" });
                            if (response.ok) {
                                alert("Sync started in the background. Please wait a few seconds and refresh this tab.");
                                setTimeout(fetchStatus, 4000);
                            } else {
                                alert("Failed to start sync.");
                            }
                        } catch (error) {
                            alert("Error starting sync.");
                        } finally {
                            syncBtn.disabled = false;
                            syncBtn.innerHTML = '<i class="fas fa-sync-alt"></i> Sync Index Now';
                        }
                    });
                }

                if (purgeBtn) {
                    purgeBtn.addEventListener("click", async function() {
                        if (!confirm("Are you sure you want to purge all indexed codebase embeddings for this project?")) return;
                        purgeBtn.disabled = true;
                        try {
                            const response = await fetch(`/api/agent/index-project/${projectId}`, { method: "DELETE" });
                            if (response.ok) {
                                alert("Index purged successfully.");
                                fetchStatus();
                            } else {
                                alert("Failed to purge index.");
                            }
                        } catch (error) {
                            alert("Error purging index.");
                        } finally {
                            purgeBtn.disabled = false;
                        }
                    });
                }

                fetchStatus();
            });
        </script>
    </div>
</div>
