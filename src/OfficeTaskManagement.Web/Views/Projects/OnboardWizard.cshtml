@model OfficeTaskManagement.Models.Project
@{
    ViewData["Title"] = "Codebase Onboarding Wizard";
}

<link rel="stylesheet" href="~/css/onboard-wizard.css" />

<div class="onboard-container mt-4">
    <!-- Header -->
    <div class="onboard-header">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h1 class="onboard-title"><i class="fas fa-sparkles"></i> Codebase Onboarding Wizard</h1>
                <p class="onboard-subtitle">Onboarding project: <strong>@Model.Name</strong></p>
            </div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-times"></i> Cancel Onboarding
            </a>
        </div>
    </div>

    <!-- Stepper Navigation -->
    <div class="wizard-steps">
        <div class="wizard-step-progress" id="step-progress-bar"></div>
        <div class="wizard-step-node active" data-step="1">
            <div class="wizard-step-circle">1</div>
            <span class="wizard-step-label">Clone & Index</span>
        </div>
        <div class="wizard-step-node" data-step="2">
            <div class="wizard-step-circle">2</div>
            <span class="wizard-step-label">Epics</span>
        </div>
        <div class="wizard-step-node" data-step="3">
            <div class="wizard-step-circle">3</div>
            <span class="wizard-step-label">Features</span>
        </div>
        <div class="wizard-step-node" data-step="4">
            <div class="wizard-step-circle">4</div>
            <span class="wizard-step-label">User Stories</span>
        </div>
        <div class="wizard-step-node" data-step="5">
            <div class="wizard-step-circle">5</div>
            <span class="wizard-step-label">Tasks & Tests</span>
        </div>
        <div class="wizard-step-node" data-step="6">
            <div class="wizard-step-circle">6</div>
            <span class="wizard-step-label">Review</span>
        </div>
    </div>

    <!-- Antiforgery Token for fetch requests -->
    @Html.AntiForgeryToken()

    <!-- STEP PANELS -->
    <div class="wizard-panels" id="wizard-panels-container" data-project-id="@Model.Id" data-has-repo-url="@(!string.IsNullOrEmpty(Model.RepositoryUrl) ? "true" : "false")" data-repo-url="@Model.RepositoryUrl">
        
        <!-- Tab 1: Clone & Index -->
        <div class="wizard-panel active" id="panel-1">
            <div class="glass-card">
                <h3><i class="fas fa-sync-alt"></i> Codebase Indexing Pipeline</h3>
                <p class="text-muted">The system is setting up your workspace files and running Gemini embedding indexer over the codebase.</p>
                
                <div class="onboard-loading-wrapper" id="indexing-loading">
                    <div class="onboard-spinner"></div>
                    <h5 id="indexing-status-text">Checking repository...</h5>
                    <div class="onboard-progress-bar">
                        <div class="onboard-progress-fill" id="indexing-progress-fill" style="width: 0%;"></div>
                    </div>
                </div>

                <div id="indexing-stats" style="display:none;" class="mt-3">
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle"></i> Indexing Pipeline Complete!
                    </div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Repository Path:</span>
                            <strong id="stat-repo-path">N/A</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Code Chunks Vectorized:</span>
                            <strong id="stat-chunks-count">0</strong>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Tab 2: Epics -->
        <div class="wizard-panel" id="panel-2">
            <div class="glass-card mb-4" id="overview-card" style="display: none;">
                <h4><i class="fas fa-analytics"></i> AI Codebase Analysis</h4>
                <div class="row mt-3">
                    <div class="col-md-6 border-end">
                        <h6>Technology Stack & Architecture</h6>
                        <div class="tech-stack-desc mb-3" id="onboard-badge-tech">N/A</div>
                        <p id="onboard-overview-summary" class="project-summary-desc">No description available.</p>
                    </div>
                    <div class="col-md-6 ps-4">
                        <h6>QA & Test Coverage Overview</h6>
                        <span class="badge badge-coverage mb-2" id="onboard-badge-coverage">N/A</span>
                        <p id="onboard-overview-tests" class="test-overview-desc">No scan results.</p>
                    </div>
                </div>
            </div>

            <div class="glass-card">
                <div class="d-flex justify-content-between align-items: center; mb-3">
                    <h3>Confirm Suggested Epics</h3>
                    <button class="btn btn-sm btn-outline-primary" id="btn-add-epic"><i class="fas fa-plus"></i> Add Custom Epic</button>
                </div>
                <p class="text-muted">Select and edit the high-level system modules proposed by the copilot.</p>

                <div id="epics-list-container" class="mt-3">
                    <!-- Dynamic -->
                </div>
            </div>
        </div>

        <!-- Tab 3: Features -->
        <div class="wizard-panel" id="panel-3">
            <div class="glass-card">
                <h3>Discover Features per Epic</h3>
                <p class="text-muted">For each confirmed Epic, the copilot reads code files to discover specific structural features.</p>
                
                <div id="features-epics-accordion" class="mt-4">
                    <!-- Dynamic nested list -->
                </div>
            </div>
        </div>

        <!-- Tab 4: User Stories -->
        <div class="wizard-panel" id="panel-4">
            <div class="glass-card">
                <h3>Formulate User Stories & Acceptance Criteria</h3>
                <p class="text-muted">Confirm user story titles, descriptions, priorities, and Given/When/Then acceptance criteria proposed by the copilot.</p>
                
                <div id="stories-features-accordion" class="mt-4">
                    <!-- Dynamic user story list -->
                </div>
            </div>
        </div>

        <!-- Tab 5: Tasks & Test Cases -->
        <div class="wizard-panel" id="panel-5">
            <div class="glass-card">
                <h3>Generate Implementation Tasks & Test Cases</h3>
                <p class="text-muted">Review calculated PERT hours (Optimistic, Most Likely, Pessimistic) and QA Test Cases. If tests are absent or incomplete in the codebase, the copilot automatically appends testing tasks and comprehensive test procedures.</p>

                <div id="tasks-stories-accordion" class="mt-4">
                    <!-- Dynamic Tasks/Tests list -->
                </div>
            </div>
        </div>

        <!-- Tab 6: Review & Finalize -->
        <div class="wizard-panel" id="panel-6">
            <div class="glass-card">
                <h3>Final Project Structure Review</h3>
                <p class="text-muted">Review the complete discovered project hierarchy before finalizing onboarding.</p>
                
                <div id="final-tree-container" class="border rounded p-4 bg-white" style="max-height: 500px; overflow-y: auto;">
                    <!-- Final Tree Display -->
                </div>

                <div class="alert alert-info mt-4">
                    <i class="fas fa-info-circle"></i> Clicking <strong>"Confirm & Initiate Project"</strong> will save this entire tree structure to the database, apply RACI and PERT values, set the project status to <strong>Active</strong>, and redirect you to the Project Dashboard.
                </div>
            </div>
        </div>

    </div>

    <!-- FOOTER CONTROLS -->
    <div class="wizard-footer">
        <button class="btn btn-outline-secondary" id="btn-wizard-prev" disabled>
            <i class="fas fa-chevron-left"></i> Previous Step
        </button>
        <button class="btn btn-primary" id="btn-wizard-next">
            Next Step <i class="fas fa-chevron-right"></i>
        </button>
    </div>
</div>

<!-- EDIT MODAL (REUSABLE FOR ALL NODES) -->
<div class="modal fade" id="wizardEditModal" tabindex="-1" aria-labelledby="wizardEditModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="wizardEditModalLabel">Edit Item</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="wizard-edit-form">
            <input type="hidden" id="edit-item-type" />
            <input type="hidden" id="edit-epic-idx" />
            <input type="hidden" id="edit-feat-idx" />
            <input type="hidden" id="edit-story-idx" />
            <input type="hidden" id="edit-task-idx" />
            <input type="hidden" id="edit-tc-idx" />

            <div class="mb-3">
                <label for="edit-title" class="form-label font-weight-bold" id="lbl-edit-title">Title</label>
                <input type="text" class="form-control" id="edit-title" required />
            </div>
            
            <div class="mb-3" id="edit-desc-group">
                <label for="edit-desc" class="form-label font-weight-bold">Description</label>
                <textarea class="form-control" id="edit-desc" rows="4"></textarea>
            </div>

            <div class="mb-3" id="edit-ac-group" style="display:none;">
                <label for="edit-ac" class="form-label font-weight-bold">Acceptance Criteria</label>
                <textarea class="form-control" id="edit-ac" rows="4"></textarea>
            </div>

            <div class="mb-3" id="edit-priority-group" style="display:none;">
                <label for="edit-priority" class="form-label font-weight-bold">Priority</label>
                <select class="form-select" id="edit-priority">
                    <option value="Low">Low</option>
                    <option value="Medium">Medium</option>
                    <option value="High">High</option>
                    <option value="Critical">Critical</option>
                </select>
            </div>

            <div class="row" id="edit-hours-group" style="display:none;">
                <div class="col-md-4">
                    <label for="edit-opt-hours" class="form-label small">Optimistic (h)</label>
                    <input type="number" step="0.5" class="form-control" id="edit-opt-hours" />
                </div>
                <div class="col-md-4">
                    <label for="edit-ml-hours" class="form-label small">Most Likely (h)</label>
                    <input type="number" step="0.5" class="form-control" id="edit-ml-hours" />
                </div>
                <div class="col-md-4">
                    <label for="edit-pess-hours" class="form-label small">Pessimistic (h)</label>
                    <input type="number" step="0.5" class="form-control" id="edit-pess-hours" />
                </div>
            </div>

            <div class="mb-3" id="edit-tc-group" style="display:none;">
                <div class="mb-2">
                    <label for="edit-tc-steps" class="form-label font-weight-bold">Steps</label>
                    <textarea class="form-control" id="edit-tc-steps" rows="3"></textarea>
                </div>
                <div>
                    <label for="edit-tc-result" class="form-label font-weight-bold">Expected Result</label>
                    <input type="text" class="form-control" id="edit-tc-result" />
                </div>
            </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="btn-save-edit-item">Save Changes</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script src="~/js/onboard-wizard.js" defer></script>
}
