@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h1><i class="fas fa-tasks"></i> TaskFlow</h1>
            <p>Sign in to your organization workspace</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="auth-error-container" role="alert"></div>

        <form id="account" method="post">
            <div class="auth-form-group">
                <label asp-for="Input.UsernameOrEmail">Username or Email</label>
                <input asp-for="Input.UsernameOrEmail" class="auth-form-control" autocomplete="username" aria-required="true" placeholder="your@email.com" required autofocus />
                <span asp-validation-for="Input.UsernameOrEmail" class="text-danger"></span>
            </div>

            <div class="auth-form-group">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" class="auth-form-control" autocomplete="current-password" aria-required="true" placeholder="••••••••" required />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; font-size: 0.9rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 500; color: var(--auth-text-muted); cursor: pointer;">
                    <input class="form-check-input" asp-for="Input.RememberMe" style="margin: 0; cursor: pointer;" />
                    Remember me
                </label>
                <a id="forgot-password" asp-page="./ForgotPassword" style="color: var(--auth-primary); font-weight: 600; text-decoration: none;">Forgot password?</a>
            </div>

            <button id="login-submit" type="submit" class="auth-btn-primary">
                <i class="fas fa-sign-in-alt"></i> Sign In
            </button>
        </form>

        <div class="auth-footer">
            <p>
                Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register organization</a>
            </p>
            <p style="margin-top: 0.5rem; font-size: 0.85rem;">
                <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" style="color: var(--auth-text-muted);">Resend email confirmation</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
