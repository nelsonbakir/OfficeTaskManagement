@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Views/Shared/_Layout.cshtml";
    }
}

<div class="profile-container">
    <div class="profile-card">
        <div class="profile-card-header" style="border-bottom: none; padding-bottom: 0.5rem;">
            <div>
                <h1 class="h3 mb-1 fw-bold text-primary">Account Settings</h1>
                <p class="text-muted mb-0 small">Manage your profile, security, and personal data.</p>
            </div>
            <div class="d-none d-md-block">
                <i class="fas fa-user-cog fs-3 text-light-emphasis" style="color: var(--auth-primary) !important; opacity: 0.35;"></i>
            </div>
        </div>

        <!-- Horizontal Top Pivot Navigation -->
        <partial name="_ManageNav" />

        <div class="profile-content-area">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
