@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="mb-4">
    <h4 class="fw-bold mb-1">Security Password</h4>
    <p class="text-secondary mb-0" style="font-size: 0.9rem;">Update your account password to keep your credentials secure.</p>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<form id="change-password-form" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-4" role="alert"></div>

    <div class="row g-4 align-items-start">
        <!-- Contextual Left Column -->
        <div class="col-12 col-md-4 col-lg-3 border-end-md pb-3 pb-md-0" style="border-right: 1px dashed var(--auth-border); text-align: center;">
            <div class="py-2">
                <i class="fas fa-key text-primary mb-3" style="font-size: 3rem; opacity: 0.35; color: var(--auth-primary) !important;"></i>
                <h6 class="fw-bold mb-1">Password Update</h6>
                <p class="text-secondary mb-0 px-2" style="font-size: 0.8rem; line-height: 1.4;">Create a password containing at least 6 characters, combining letters, numbers, and symbols to ensure maximum account security.</p>
            </div>
        </div>

        <!-- Form Fields Right Column -->
        <div class="col-12 col-md-8 col-lg-9">
            <div class="profile-form-grid">
                <div class="profile-form-group">
                    <label asp-for="Input.OldPassword" class="fw-semibold">Current Password</label>
                    <input asp-for="Input.OldPassword" class="profile-form-control" autocomplete="current-password" aria-required="true" placeholder="Enter your current password" />
                    <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
                </div>

                <div class="profile-form-group">
                    <label asp-for="Input.NewPassword" class="fw-semibold">New Password</label>
                    <input asp-for="Input.NewPassword" class="profile-form-control" autocomplete="new-password" aria-required="true" placeholder="Enter your new password" />
                    <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                </div>

                <div class="profile-form-group">
                    <label asp-for="Input.ConfirmPassword" class="fw-semibold">Confirm New Password</label>
                    <input asp-for="Input.ConfirmPassword" class="profile-form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm your new password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top">
                <button type="submit" class="profile-btn-save">
                    <i class="fas fa-save me-2"></i> Update Password
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
