@page
@model IndexModel
@{
    ViewData["Title"] = "Profile Management";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="mb-4">
    <h4 class="fw-bold mb-1">Public Profile</h4>
    <p class="text-secondary mb-0" style="font-size: 0.9rem;">Update your personal information and how others see you on the platform.</p>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<form id="profile-form" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-4" role="alert"></div>

    <div class="row g-4 align-items-start">
        <!-- Avatar Picture Selection Column (Left Side) -->
        <div class="col-12 col-md-4 col-lg-3 border-end-md pb-3 pb-md-0" style="border-right: 1px dashed var(--auth-border); text-align: center;">
            <div class="py-2">
                <div class="profile-avatar-section">
                    <div class="profile-avatar-preview mb-2">
                        @if (!string.IsNullOrEmpty(Model.Input.AvatarPath))
                        {
                            <img src="@Model.Input.AvatarPath" alt="Avatar" />
                        }
                        else
                        {
                            <i class="fas fa-user"></i>
                        }
                    </div>
                    <div class="w-100 text-center">
                        <label asp-for="Input.Avatar" class="form-label fw-bold mb-1" style="font-size: 0.9rem;">Profile Picture</label>
                        <input asp-for="Input.Avatar" type="file" class="form-control form-control-sm mb-1" accept="image/*" />
                        <div class="form-text" style="font-size: 0.75rem;">JPG, PNG or WebP images supported.</div>
                        <span asp-validation-for="Input.Avatar" class="text-danger d-block"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Input Fields Column (Right Side) -->
        <div class="col-12 col-md-8 col-lg-9">
            <div class="profile-form-grid">
                <div class="profile-form-group">
                    <label asp-for="Input.Username" class="fw-semibold">Username</label>
                    <input asp-for="Input.Username" class="profile-form-control" placeholder="Your unique username" />
                    <span asp-validation-for="Input.Username" class="text-danger"></span>
                </div>

                <div class="profile-form-group">
                    <label asp-for="Input.FullName" class="fw-semibold">Full Name</label>
                    <input asp-for="Input.FullName" class="profile-form-control" placeholder="Your full name" />
                    <span asp-validation-for="Input.FullName" class="text-danger"></span>
                </div>

                <div class="profile-form-group">
                    <label asp-for="Input.PhoneNumber" class="fw-semibold">Phone Number</label>
                    <input asp-for="Input.PhoneNumber" class="profile-form-control" placeholder="Your phone number" />
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top">
                <button id="update-profile-button" type="submit" class="profile-btn-save">
                    <i class="fas fa-save me-2"></i> Save Changes
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
