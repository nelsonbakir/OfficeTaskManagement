@page
@model EmailModel
@{
    ViewData["Title"] = "Manage Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="mb-4">
    <h4 class="fw-bold mb-1">Email Settings</h4>
    <p class="text-secondary mb-0" style="font-size: 0.9rem;">Manage your primary email address and verification status.</p>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<form id="email-form" method="post">
    <div asp-validation-summary="All" class="text-danger mb-4" role="alert"></div>

    <div class="row g-4 align-items-start">
        <!-- Contextual Left Column -->
        <div class="col-12 col-md-4 col-lg-3 border-end-md pb-3 pb-md-0" style="border-right: 1px dashed var(--auth-border); text-align: center;">
            <div class="py-2">
                <i class="fas fa-envelope text-primary mb-3" style="font-size: 3rem; opacity: 0.35; color: var(--auth-primary) !important;"></i>
                <h6 class="fw-bold mb-1">Email Identity</h6>
                <p class="text-secondary mb-0 px-2" style="font-size: 0.8rem; line-height: 1.4;">Your verified email address is used for password recovery, secure authentication, and workspace notifications.</p>
            </div>
        </div>

        <!-- Form Fields Right Column -->
        <div class="col-12 col-md-8 col-lg-9">
            <div class="profile-form-grid">
                <div class="profile-form-group">
                    <label asp-for="Email" class="fw-semibold">Current Email</label>
                    <div class="input-group">
                        <input asp-for="Email" class="profile-form-control" placeholder="Please enter your email." disabled style="background-color: #F3F2F1;" />
                        @if (Model.IsEmailConfirmed)
                        {
                            <span class="input-group-text text-success bg-white border-start-0" style="border: 1px solid #EDEBE9; border-left: none; display: flex; align-items: center; justify-content: center; width: 42px;" title="Email Confirmed">
                                <i class="fas fa-check-circle"></i>
                            </span>
                        }
                    </div>
                    @if (!Model.IsEmailConfirmed)
                    {
                        <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link p-0 mt-2 text-decoration-none small">
                            <i class="fas fa-paper-plane me-1"></i> Send verification email
                        </button>
                    }
                </div>

                <div class="profile-form-group">
                    <label asp-for="Input.NewEmail" class="fw-semibold">New Email Address</label>
                    <input asp-for="Input.NewEmail" class="profile-form-control" autocomplete="email" aria-required="true" placeholder="Enter new email address" />
                    <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top">
                <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="profile-btn-save">
                    <i class="fas fa-exchange-alt me-2"></i> Update Email
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
