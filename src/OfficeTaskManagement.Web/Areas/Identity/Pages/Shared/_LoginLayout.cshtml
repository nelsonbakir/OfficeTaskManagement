<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskFlow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/modern-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth-styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OfficeTaskManagement.styles.css" asp-append-version="true" />
    <!-- Theme Manager -->
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
</head>
<body>
    <!-- Floating Theme Toggle -->
    <div style="position: absolute; top: 1.5rem; right: 1.5rem; z-index: 1000;">
        <button class="btn btn-light border theme-toggle-btn rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;" type="button" title="Toggle theme">
            <i class="fas fa-moon"></i>
        </button>
    </div>
    @RenderBody()

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
